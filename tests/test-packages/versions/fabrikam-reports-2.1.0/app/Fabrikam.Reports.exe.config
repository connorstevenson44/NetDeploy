<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="ReportTitle" value="Fabrikam monthly sales" />
    <add key="DataFolder" value="data" />
    <add key="OutputFolder" value="reports" />
    <add key="KeepReports" value="90" />
    <add key="MaxRows" value="10000" />
    <add key="SmtpServer" value="smtp.fabrikam.local" />
    <add key="SmtpPassword" value="" />
  </appSettings>
  <connectionStrings>
    <add name="Warehouse" connectionString="Server=sql01;Database=Warehouse;Integrated Security=true" providerName="System.Data.SqlClient" />
    <add name="Audit" connectionString="Server=sql01;Database=Audit;Integrated Security=true" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.diagnostics>
    <trace autoflush="true" indentsize="2" />
  </system.diagnostics>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ReportsFolder" value="..\reports" />
    <add key="AllowDownload" value="true" />
    <add key="PageSize" value="25" />
  </appSettings>
  <system.webServer>
    <defaultDocument>
      <files><add value="index.html" /></files>
    </defaultDocument>
    <staticContent>
      <mimeMap fileExtension=".csv" mimeType="text/csv" />
      <mimeMap fileExtension=".xlsx" mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
    </staticContent>
  </system.webServer>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ReportsFolder" value="..\reports" />
    <add key="AllowDownload" value="true" />
  </appSettings>
  <system.webServer>
    <defaultDocument>
      <files><add value="index.html" /></files>
    </defaultDocument>
    <staticContent>
      <mimeMap fileExtension=".csv" mimeType="text/csv" />
    </staticContent>
  </system.webServer>
</configuration>

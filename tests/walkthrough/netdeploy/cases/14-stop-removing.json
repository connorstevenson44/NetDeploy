{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/walkthrough.case.schema.json",
  "name": "Change your mind while removing an install",
  "needs": ["clone-main"],
  "covers": "Stop removing, at the first step, leaving the install as it was",
  "steps": [
    { "call": "goToRoot" },
    { "call": "removeInstall", "with": { "path": "${ordersDir}\\qa", "choice": "stop" } },
    { "checkpoint": "qa is just as it was",
      "checks": [
        { "service": "Contoso.Orders-qa", "state": "Running" },
        { "scheduledTask": "\\Contoso\\Orders Export-qa" },
        { "fileExists": "${ordersDir}\\qa\\Contoso.Orders.exe" },
        { "fileExists": "${ordersData}\\db-qa\\orders.db" }
      ],
      "look": [
        "The removal window said what its first step would do, and nothing ran.",
        "The bar at the bottom says Removal stopped.",
        "qa is still in the folder list, with its green dot."
      ],
      "tools": [
        { "openFolder": "${ordersDir}\\qa", "label": "Open qa" },
        { "console": "& '${suiteDir}\\tools\\Services.ps1' @args", "args": ["Contoso.Orders"], "label": "Services" }
      ] }
  ]
}

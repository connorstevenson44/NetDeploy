{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/walkthrough.case.schema.json",
  "name": "Upgrade Fabrikam.Reports to 2.1.0",
  "needs": ["add-reports"],
  "covers": "Settings changed by hand on the server, a tick box setting, combining older-style settings files, and plugins swapped",
  "steps": [
    { "powershell": ["$config, $web = $args", "function Set-AppSetting($file, $key, $value) {", "    $xml = [xml](Get-Content -Raw -LiteralPath $file)", "    ($xml.configuration.appSettings.add | Where-Object { $_.key -eq $key }).value = $value", "    $xml.Save($file)", "}", "Set-AppSetting $config 'ReportTitle' 'Fabrikam weekly sales'", "Set-AppSetting $config 'KeepReports' '45'", "Set-AppSetting $web 'AllowDownload' 'false'"], "args": ["${reportsDir}\\main\\Fabrikam.Reports.exe.config", "${reportsDir}\\main\\wwwroot\\web.config"], "say": "Change three settings on the server by hand: ReportTitle, KeepReports and the website's AllowDownload" },
    { "call": "openPackage", "with": { "zip": "${packages}\\Fabrikam.Reports-2.1.0.zip" } },
    { "call": "waitHeader", "with": { "title": "Fabrikam.Reports 2.1.0" } },
    { "tick": { "checkBox": "Publish the report site" }, "checked": true, "say": "Tick Publish the report site" },
    { "click": { "button": "Update" }, "say": "Click Update to upgrade Fabrikam.Reports" },
    { "call": "waitStage", "with": { "title": "Check the files" } },
    { "hover": { "element": "fileName", "with": { "path": "plugins/Fabrikam.Reports.Pdf.dll" } }, "say": "The PDF plugin will be deleted" },
    { "hover": { "element": "fileName", "with": { "path": "plugins/Fabrikam.Reports.Excel.dll" } }, "say": "and the Excel one added" },
    { "call": "continueStage" },
    { "call": "waitStage", "with": { "title": "Check the config" } },
    { "call": "configFile", "with": { "name": "Fabrikam.Reports.exe.config" } },
    { "say": "ReportTitle keeps the server's text. KeepReports always takes the package's 90. MaxRows is new, and LegacyPdfEngine is gone." },
    { "call": "configFile", "with": { "name": "web.config" } },
    { "say": "web.config keeps the server's AllowDownload, and gets the new PageSize." },
    { "call": "continueStage" },
    { "answerDialog": "NetDeploy", "button": "Yes", "expect": "Run a report now to check the install?", "within": 120, "say": "Say Yes to running a report now" },
    { "find": { "window": "Schedule the hourly report" }, "within": 120, "what": "the \"Schedule the hourly report\" window" },
    { "call": "answerInputs", "with": { "title": "Schedule the hourly report", "say": "Keep SYSTEM as the account" } },
    { "call": "waitStatus", "with": { "startsWith": "Deploy finished.", "within": "300" }, "as": "status" },
    { "checkpoint": "Fabrikam.Reports is on 2.1.0, with the server's changes kept",
      "checks": [
        { "logged": "${logFile(status)}", "text": "left as it is" },
        { "logged": "${logFile(status)}", "text": "plugins: csv, xlsx" },
        { "logged": "${logFile(status)}", "text": "Check passed." },
        { "fileMissing": "${reportsDir}\\main\\plugins\\Fabrikam.Reports.Pdf.dll" },
        { "fileCount": "${reportsDir}\\main\\reports", "pattern": "*.xlsx", "equals": 1 },
        { "appSetting": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "key": "ReportTitle", "equals": "Fabrikam weekly sales" },
        { "appSetting": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "key": "KeepReports", "equals": "90" },
        { "appSetting": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "key": "LegacyPdfEngine", "equals": "<absent>" },
        { "connectionString": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "name": "Audit" },
        { "fileContains": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "text": "newVersion=\"13.0.0.0\"", "label": "The library version it points to comes from the new file" },
        { "appSetting": "${reportsDir}\\main\\wwwroot\\web.config", "key": "AllowDownload", "equals": "false" },
        { "appSetting": "${reportsDir}\\main\\wwwroot\\web.config", "key": "PageSize", "equals": "25" }
      ],
      "look": [
        "The list of files showed the PDF plugin deleted and the Excel one added.",
        "The reports folder has the first report as a .pdf, and the new one as an .xlsx."
      ],
      "tools": [
        { "openFile": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "label": "Open .exe.config" },
        { "openFile": "${reportsDir}\\main\\wwwroot\\web.config", "label": "Open web.config" },
        { "openFolder": "${reportsDir}\\main\\reports", "label": "Open reports" },
        { "openFile": "${logFile(status)}", "label": "Open the log" }
      ] }
  ]
}

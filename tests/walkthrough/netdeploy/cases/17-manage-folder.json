{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/walkthrough.case.schema.json",
  "name": "Look after an install folder without a package",
  "needs": ["clone-main"],
  "covers": "Open folder, the version of each install, running a program with what to pass it, deleting a file, and Up",
  "steps": [
    { "click": { "button": "Open folder" }, "say": "Click Open folder" },
    { "pickFolder": "Open an install folder", "path": "${ordersDir}", "say": "Pick C:\\Apps\\Contoso.Orders" },
    { "call": "waitHeader", "with": { "title": "Contoso.Orders" } },
    { "say": "Without a package, the folder is for looking after what is already there: each install, with its version." },
    { "call": "goInto", "with": { "path": "${ordersDir}\\qa" } },
    { "call": "fileButton", "with": { "path": "Contoso.Orders.exe", "tip": "Run, with arguments", "say": "Run Contoso.Orders.exe" } },
    { "find": { "window": "Run Contoso.Orders.exe" }, "within": 120, "what": "the \"Run Contoso.Orders.exe\" window" },
    { "type": { "edit": "Arguments", "within": { "window": "Run Contoso.Orders.exe" } }, "text": "check", "say": "Type check" },
    { "call": "answerInputs", "with": { "title": "Run Contoso.Orders.exe", "say": "Ask it to check its settings" } },
    { "call": "waitStatus", "with": { "startsWith": "Contoso.Orders.exe exited with code" }, "as": "status" },
    { "tab": "Files", "say": "Open the Files tab" },
    { "call": "fileButton", "with": { "path": "README.txt", "tip": "Delete when finalized", "say": "Mark README.txt to be deleted" } },
    { "click": "finalize", "say": "Click Finalize" },
    { "answerDialog": "Finalize", "button": "Yes", "expect": "README.txt", "say": "Yes, delete it" },
    { "call": "waitStatus", "with": { "startsWith": "Changes written." } },
    { "call": "goInto", "with": { "path": "${ordersDir}\\qa\\templates" } },
    { "say": "Going into an ordinary folder just lists its files." },
    { "click": "upOneFolder", "say": "Go up a folder" },
    { "checkpoint": "The folder was looked after without a package",
      "checks": [
        { "contains": "${status}", "text": "code 0.", "label": "Contoso.Orders.exe check finished without an error (exit code 0)" },
        { "fileMissing": "${ordersDir}\\qa\\README.txt" }
      ],
      "look": [
        "The folder list showed green, main and qa, each on v1.1.0.",
        "The Log tab shows what the settings check printed, ending Check passed.",
        "The title bar says Contoso.Orders and C:\\Apps\\Contoso.Orders, and there is no PACKAGE section."
      ],
      "tools": [
        { "openFolder": "${ordersDir}\\qa", "label": "Open qa" }
      ] }
  ]
}

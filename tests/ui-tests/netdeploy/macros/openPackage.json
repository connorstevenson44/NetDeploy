{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/macro.schema.json",
  "description": "Opens a package zip with Open package and the Windows file picker.",
  "params": { "zip": { "description": "The package's full path." } },
  "steps": [
    { "click": { "button": "Open package" }, "say": "Click Open package" },
    { "pickFile": "Open a deploy package", "path": "${zip}", "say": "Pick ${fileName(zip)}" }
  ]
}

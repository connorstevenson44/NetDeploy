{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/macro.schema.json",
  "description": "Clicks Continue in a window that asks for a step's details, and waits for it to close.",
  "params": {
    "title": { "description": "The window's title." }
  },
  "steps": [
    { "click": { "button": "Continue", "within": { "window": "${title}" } } },
    { "waitGone": { "window": "${title}" }, "within": 10 }
  ]
}

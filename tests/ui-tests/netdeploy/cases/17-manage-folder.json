{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Manage an install folder without a package",
  "needs": ["clone-main"],
  "covers": "Open folder, each install's version, running a program with arguments, deleting a file, and Up",
  "tags": ["files"],
  "steps": [
    { "click": { "button": "Open folder" } },
    { "pickFolder": "Open an install folder", "path": "${ordersDir}" },
    { "call": "waitForHeader", "with": { "title": "Contoso.Orders" } },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\qa" } },
    { "call": "clickFileRowButton", "with": { "path": "Contoso.Orders.exe", "tip": "Run, with arguments" } },
    { "find": { "window": "Run Contoso.Orders.exe" }, "within": 120 },
    { "type": { "edit": "Arguments", "within": { "window": "Run Contoso.Orders.exe" } }, "text": "check" },
    { "call": "continueInputsWindow", "with": { "title": "Run Contoso.Orders.exe" } },
    { "call": "waitForStatusBar", "with": { "startsWith": "Contoso.Orders.exe exited with code" }, "as": "status" },
    { "tab": "Files" },
    { "call": "clickFileRowButton", "with": { "path": "README.txt", "tip": "Delete when finalized" } },
    { "click": "finalize" },
    { "answerDialog": "Finalize", "button": "Yes", "expect": "README.txt" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Changes written." } },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\qa\\templates" } },
    { "click": "upOneFolder", "what": "Up one folder" },
    { "checkpoint": "The folder is managed without a package",
      "checks": [
        { "contains": "${status}", "text": "code 0.", "label": "Contoso.Orders.exe check" },
        { "fileMissing": "${ordersDir}\\qa\\README.txt" }
      ],
      "look": [
        "Folder list: green, main and qa, each v1.1.0.",
        "Log tab: the check's output, ending Check passed.",
        "Title bar: Contoso.Orders and C:\\Apps\\Contoso.Orders. No PACKAGE section."
      ],
      "tools": [
        { "openFolder": "${ordersDir}\\qa", "label": "qa" }
      ] }
  ]
}

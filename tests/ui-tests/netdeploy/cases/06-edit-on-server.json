{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Change settings on the server",
  "needs": ["add-main"],
  "covers": "Going into an install, folding a folder, filtering the files, editing with tracked changes, undoing one change, staging a delete and taking it back, and Finalize",
  "steps": [
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\main" } },
    { "say": "Going into main makes it what the next deploy updates, so the button now says Update. Its files are listed on the right." },
    { "tab": "Files", "say": "Open the Files tab" },
    { "click": { "element": "fileFolder", "with": { "path": "templates" } }, "say": "Fold up the templates folder, as in File Explorer" },
    { "click": { "element": "fileFolder", "with": { "path": "templates" } }, "say": "And open it again" },
    { "call": "openFileInEditor", "with": { "path": "appsettings.json" } },
    { "replaceText": "fileText", "regex": "(\"Region\":\\s*)\"east\"", "replacement": "$1\"west\"", "say": "Change Region to west, as someone might on the server" },
    { "say": "The change shows where it was made: east crossed out in red, west in green." },
    { "replaceText": "fileText", "regex": "(\"HeartbeatSeconds\":\\s*)10", "replacement": "$${1}20", "say": "Change HeartbeatSeconds to 20" },
    { "click": { "button": "Undo", "helpText": "Put back the server's text: 10" }, "say": "Then undo just that change, with the button at the end of its line" },
    { "replaceText": "fileText", "regex": "^\\s*\\{", "replacement": "{\r\n  \"Alerts\": { \"Emails\": [ \"ops@contoso.local\", \"oncall@contoso.local\" ] },", "say": "Add an Alerts section, with a list of emails, at the top of the file" },
    { "say": "The new line is green. The Region change is still there, and HeartbeatSeconds is back to 10." },
    { "type": "filterFiles", "text": "config", "say": "Type config in the filter box, to list only the files with config in their name" },
    { "call": "openFileInEditor", "with": { "path": "export/Contoso.Orders.Export.exe.config" } },
    { "replaceText": "fileText", "regex": "(key=\"BatchSize\"\\s+value=)\"500\"", "replacement": "$1\"750\"", "say": "Change the export tool's BatchSize to 750" },
    { "type": "filterFiles", "text": "", "say": "Clear the filter box" },
    { "find": { "text": "3 changes" }, "what": "the bar at the bottom saying 3 changes" },
    { "call": "clickFileRowButton", "with": { "path": "README.txt", "tip": "Delete when finalized", "say": "Mark README.txt to be deleted" } },
    { "find": { "text": "3 changes, 1 file to delete" }, "what": "the bar saying a file will be deleted" },
    { "call": "clickFileRowButton", "with": { "path": "README.txt", "tip": "Keep this file", "say": "Change your mind and keep README.txt" } },
    { "click": "finalize", "say": "Click Finalize to write the changes" },
    { "answerDialog": "Finalize", "button": "Yes", "expect": "Write 2 changes to main/appsettings.json", "say": "Yes, write the changes" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Changes written." } },
    { "checkpoint": "The server's settings changed",
      "checks": [
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Orders:Region", "equals": "west" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Orders:HeartbeatSeconds", "equals": "10" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Alerts:Emails", "equals": "ops@contoso.local oncall@contoso.local" },
        { "appSetting": "${ordersDir}\\main\\export\\Contoso.Orders.Export.exe.config", "key": "BatchSize", "equals": "750" },
        { "fileExists": "${ordersDir}\\main\\README.txt" }
      ],
      "look": [
        "Finalize asked about exactly the two settings files.",
        "README.txt is still in the list, and not crossed out.",
        "appsettings.json has the Alerts section just as it was typed, Region west, and is otherwise laid out as before."
      ],
      "tools": [
        { "openFile": "${ordersDir}\\main\\appsettings.json" },
        { "openFile": "${ordersDir}\\main\\export\\Contoso.Orders.Export.exe.config", "label": "Open the export's settings" }
      ] }
  ]
}

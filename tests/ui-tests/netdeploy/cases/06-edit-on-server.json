{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Edit main's settings on the server",
  "needs": ["add-main"],
  "covers": "Going into an install, folding a folder, filtering files, tracked edits, undoing one edit, staging a delete and taking it back, and Finalize",
  "tags": ["files"],
  "steps": [
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\main" } },
    { "tab": "Files" },
    { "click": { "element": "fileFolder", "with": { "path": "templates" } }, "what": "templates" },
    { "click": { "element": "fileFolder", "with": { "path": "templates" } }, "what": "templates" },
    { "call": "openFileInEditor", "with": { "path": "appsettings.json" } },
    { "replaceText": "fileText", "regex": "(\"Region\":\\s*)\"east\"", "replacement": "$1\"west\"" },
    { "replaceText": "fileText", "regex": "(\"HeartbeatSeconds\":\\s*)10", "replacement": "$${1}20" },
    { "click": { "button": "Undo", "helpText": "Put back the server's text: 10" } },
    { "replaceText": "fileText", "regex": "^\\s*\\{", "replacement": "{\r\n  \"Alerts\": { \"Emails\": [ \"ops@contoso.local\", \"oncall@contoso.local\" ] }," },
    { "type": "filterFiles", "text": "config" },
    { "call": "openFileInEditor", "with": { "path": "export/Contoso.Orders.Export.exe.config" } },
    { "replaceText": "fileText", "regex": "(key=\"BatchSize\"\\s+value=)\"500\"", "replacement": "$1\"750\"" },
    { "type": "filterFiles", "text": "" },
    { "find": { "text": "3 changes" } },
    { "call": "clickFileRowButton", "with": { "path": "README.txt", "tip": "Delete when finalized" } },
    { "find": { "text": "3 changes, 1 file to delete" } },
    { "call": "clickFileRowButton", "with": { "path": "README.txt", "tip": "Keep this file" } },
    { "click": "finalize" },
    { "answerDialog": "Finalize", "button": "Yes", "expect": "Write 2 changes to main/appsettings.json" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Changes written." } },
    { "checkpoint": "Edits are written, README.txt kept",
      "checks": [
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Orders:Region", "equals": "west" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Orders:HeartbeatSeconds", "equals": "10" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Alerts:Emails", "equals": "ops@contoso.local oncall@contoso.local" },
        { "appSetting": "${ordersDir}\\main\\export\\Contoso.Orders.Export.exe.config", "key": "BatchSize", "equals": "750" },
        { "fileExists": "${ordersDir}\\main\\README.txt" }
      ],
      "look": [
        "Finalize listed only the two settings files.",
        "README.txt is listed and not crossed out.",
        "appsettings.json keeps its layout, with Alerts as typed."
      ],
      "tools": [
        { "openFile": "${ordersDir}\\main\\appsettings.json" },
        { "openFile": "${ordersDir}\\main\\export\\Contoso.Orders.Export.exe.config", "label": "Export settings" }
      ] }
  ]
}

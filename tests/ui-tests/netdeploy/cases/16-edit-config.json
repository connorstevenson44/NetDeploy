{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Edit a deploy.json",
  "needsNote": "Any time",
  "covers": "Open config, the list of steps, the form and the text view, a problem shown as you type, and Save",
  "tags": ["config-editor"],
  "steps": [
    { "unzip": "${packages}\\Contoso.Orders-1.1.0.zip", "to": "${temp}\\editor" },
    { "click": { "button": "Open config" } },
    { "pickFile": "Open a deploy config", "path": "${temp}\\editor\\deploy.json" },
    { "tab": "deploy.json" },
    { "click": { "type": "Text", "helpText": "Copy the app" }, "how": "mouse" },
    { "click": { "radioButton": "JSON" } },
    { "click": { "radioButton": "Form" } },
    { "click": { "type": "Text", "helpText": "App and parameters" }, "how": "mouse" },
    { "type": { "edit": "Version" }, "text": "" },
    { "type": { "edit": "Version" }, "text": "1.1.1" },
    { "click": { "button": "Save" } },
    { "call": "waitForHeader", "with": { "title": "Contoso.Orders 1.1.1" } },
    { "checkpoint": "deploy.json is saved as 1.1.1",
      "checks": [
        { "fileContains": "${temp}\\editor\\deploy.json", "text": "1.1.1" }
      ],
      "look": [
        "Title bar: Contoso.Orders 1.1.1 and the unzipped folder.",
        "A missing version problem showed while Version was empty, and went once it was typed.",
        "deploy.json keeps its $schema line and its settings' order."
      ],
      "tools": [
        { "openFile": "${temp}\\editor\\deploy.json", "label": "deploy.json" }
      ] }
  ]
}

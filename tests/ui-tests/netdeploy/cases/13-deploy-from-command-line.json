{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Deploy from the command line",
  "needs": ["clone-main"],
  "covers": "NetDeploy.exe deploy as a pipeline runs it: a command missing --install, a dry run that changes nothing, a deploy with a secret from the environment, and the deploy in the history",
  "tags": ["cli", "deploy"],
  "steps": [
    { "script": "tools/Count-Deploys.ps1", "args": ["${ordersDir}\\qa", "${historyDir}"], "as": "before" },
    { "run": "${exe}", "args": ["deploy", "${packages}\\Contoso.Orders-1.1.0.zip"], "as": "mistake" },
    { "run": "${exe}", "args": ["deploy", "${packages}\\Contoso.Orders-1.1.0.zip", "--install", "qa", "--dry-run", "--yes"], "env": { "NETDEPLOY_PaymentsApiKey": "${apiKey}" }, "as": "dryRun" },
    { "script": "tools/Count-Deploys.ps1", "args": ["${ordersDir}\\qa", "${historyDir}", "${before.first}"], "as": "addedByDryRun" },
    { "run": "${exe}", "args": ["deploy", "${packages}\\Contoso.Orders-1.1.0.zip", "--install", "qa", "--yes"], "env": { "NETDEPLOY_PaymentsApiKey": "${apiKey}" }, "as": "deploy" },
    { "script": "tools/Count-Deploys.ps1", "args": ["${ordersDir}\\qa", "${historyDir}", "${before.first}"], "as": "added" },
    { "call": "goUpToInstallFolder" },
    { "click": "refresh", "what": "Refresh" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\qa" } },
    { "checkpoint": "qa was deployed from the command line",
      "checks": [
        { "equals": "${mistake.code}", "to": "2", "label": "No --install: exit code" },
        { "contains": "${mistake.output}", "text": "--install", "label": "No --install: output" },
        { "equals": "${dryRun.code}", "to": "0", "label": "Dry run: exit code" },
        { "contains": "${dryRun.output}", "text": "Dry run finished. Nothing was changed.", "label": "Dry run: output" },
        { "equals": "${addedByDryRun.first}", "to": "0", "label": "Dry run: deploys added to history" },
        { "equals": "${deploy.code}", "to": "0", "label": "Deploy: exit code" },
        { "contains": "${deploy.output}", "text": "Deploy finished.", "label": "Deploy: output" },
        { "lacks": "${deploy.output}", "text": "${apiKey}", "label": "Deploy: output" },
        { "equals": "${added.first}", "to": "1", "label": "Deploy: deploys added to history" },
        { "shows": { "text": "1.1.0 deployed" }, "within": 10, "label": "HISTORY" },
        { "service": "Contoso.Orders-qa", "state": "Running" },
        { "jsonValue": "${ordersDir}\\qa\\appsettings.json", "path": "Payments:ApiKey", "equals": "${apiKey}" },
        { "jsonValue": "${ordersDir}\\qa\\appsettings.json", "path": "Orders:Region", "equals": "west" }
      ],
      "look": [
        "Each command's output is under it in the panel, and in run.log: the deploy's log, then its log file's path.",
        "HISTORY: the newest deploy is by you, a minute ago."
      ],
      "tools": [
        { "openFile": "${resultsDir}\\run.log", "label": "run.log" },
        { "openFolder": "${ordersDir}\\qa", "label": "qa" },
        { "console": "& '${suiteDir}\\tools\\Show-Services.ps1' @args", "args": ["Contoso.Orders"], "label": "Services" }
      ] }
  ]
}

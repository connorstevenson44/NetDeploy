{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Cancel an upgrade and roll back",
  "needs": ["add-blue"],
  "covers": "The newer-version arrow, a secret setting, the files an upgrade adds and deletes, a yes/no question, Cancel during a deploy, and Roll back",
  "tags": ["upgrade", "rollback"],
  "steps": [
    { "call": "openPackage", "with": { "zip": "${packages}\\Contoso.Orders-1.1.0.zip" } },
    { "call": "waitForHeader", "with": { "title": "Contoso.Orders 1.1.0" } },
    { "type": { "edit": "Payments API key (new in 1.1)" }, "text": "${apiKey}", "secret": true },
    { "call": "goUpToInstallFolder" },
    { "checkpoint": "blue is marked as having an update",
      "checks": [
        { "shows": { "text": "The package (1.1.0) is newer: deploying here updates it.", "within": { "element": "folderRow", "with": { "path": "${ordersDir}\\blue" } } },
          "within": 10, "label": "blue's version arrow" }
      ] },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\blue" } },
    { "click": { "button": "Update" } },
    { "call": "waitForReview", "with": { "title": "Check the files" } },
    { "hover": { "element": "fileName", "with": { "path": "templates/password-reset.html" } }, "what": "password-reset.html" },
    { "hover": { "element": "fileName", "with": { "path": "templates/return-received.html" } }, "what": "return-received.html" },
    { "call": "continuePastReview" },
    { "answerDialog": "NetDeploy", "button": "No", "expect": "Run a settings check on the old version first?" },
    { "call": "waitForReview", "with": { "title": "Check the config" } },
    { "click": { "button": "Cancel" } },
    { "answerDialog": "Roll back", "button": "Yes", "expect": "Restore the backup" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Rolled back to the backup.", "within": "120" } },
    { "checkpoint": "blue is back on 1.0.0",
      "checks": [
        { "service": "Contoso.Orders-blue", "state": "Running" },
        { "fileVersion": "${ordersDir}\\blue\\Contoso.Orders.exe", "startsWith": "1.0.0" },
        { "fileExists": "${ordersDir}\\blue\\templates\\password-reset.html" },
        { "fileMissing": "${ordersDir}\\blue\\templates\\return-received.html" }
      ],
      "look": [
        "Files review: password-reset.html crossed out in red, return-received.html new.",
        "Log tab: the cancel, then the backup put back and the service started.",
        "blue.backups, next to blue, holds the backup."
      ],
      "tools": [
        { "openFolder": "${ordersDir}\\blue", "label": "blue" },
        { "openFolder": "${ordersDir}", "label": "Install folder" },
        { "console": "& '${suiteDir}\\tools\\Show-Services.ps1' @args", "args": ["Contoso.Orders"], "label": "Services" }
      ] }
  ]
}

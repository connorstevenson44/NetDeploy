{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Upgrade main to 1.1.0, keeping server edits",
  "needs": ["restore-backup"],
  "covers": "Each install's remembered settings, showing unchanged files, changing what happens to a file, merging settings, a renamed setting, and settings that need a value",
  "tags": ["upgrade", "config"],
  "steps": [
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\main" } },
    { "find": "environment", "as": "environment" },
    { "click": { "button": "Update" } },
    { "call": "waitForReview", "with": { "title": "Check the files" } },
    { "click": { "type": "Button", "helpText": "Show files that are the same on the server" }, "what": "Show unchanged files" },
    { "click": { "type": "Button", "helpText": "Show files that are the same on the server" }, "what": "Show unchanged files" },
    { "call": "clickFileRowButton", "with": { "path": "templates/order-confirmation.html", "tip": "Keep the server's file as it is" } },
    { "call": "clickFileRowButton", "with": { "path": "templates/order-confirmation.html", "tip": "Replace with the package's file" } },
    { "call": "continuePastReview" },
    { "answerDialog": "NetDeploy", "button": "Yes", "expect": "Run a settings check on the old version first?" },
    { "call": "waitForReview", "with": { "title": "Check the config" } },
    { "call": "showConfigFileDiff", "with": { "name": "appsettings.json" } },
    { "click": { "button": "Next change" } },
    { "replaceText": "fileText", "regex": "(\"ApiKey\":\\s*)\"\"", "replacement": "$1\"${apiKey}\"" },
    { "call": "showConfigFileDiff", "with": { "name": "appsettings.Production.json" } },
    { "call": "showConfigFileDiff", "with": { "name": "Contoso.Orders.Export.exe.config" } },
    { "click": { "button": "Keep the server's", "helpText": "appSettings:BatchSize", "match": "contains" }, "what": "Keep the server's BatchSize" },
    { "call": "continuePastReview" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Deploy finished.", "within": "300" }, "as": "status" },
    { "checkpoint": "main is on 1.1.0 with the server's edits",
      "checks": [
        { "equals": "${environment.selection}", "to": "Staging", "label": "Remembered environment" },
        { "service": "Contoso.Orders-main", "state": "Running" },
        { "fileVersion": "${ordersDir}\\main\\Contoso.Orders.exe", "startsWith": "1.1.0" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Orders:Region", "equals": "west" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Orders:BatchSize", "equals": "250" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Smtp:Host", "equals": "smtp.contoso.local" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Smtp:Server", "equals": "<absent>" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "LegacyMode", "equals": "<absent>" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Payments:ApiKey", "equals": "${apiKey}" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Logging:LogLevel:Contoso.Orders", "equals": "Debug" },
        { "fileMissing": "${ordersDir}\\main\\PRODUCTION.txt" },
        { "fileExists": "${ordersDir}\\main\\appsettings.Production.json" },
        { "fileMissing": "${ordersDir}\\main\\templates\\password-reset.html" },
        { "fileExists": "${ordersDir}\\main\\templates\\return-received.html" },
        { "fileExists": "${ordersDir}\\blue\\templates\\password-reset.html" },
        { "appSetting": "${ordersDir}\\main\\export\\Contoso.Orders.Export.exe.config", "key": "BatchSize", "equals": "750" },
        { "appSetting": "${ordersDir}\\main\\export\\Contoso.Orders.Export.exe.config", "key": "Format", "equals": "json" },
        { "appSetting": "${ordersDir}\\main\\export\\Contoso.Orders.Export.exe.config", "key": "IncludeCancelled", "equals": "<absent>" },
        { "connectionString": "${ordersDir}\\main\\export\\Contoso.Orders.Export.exe.config", "name": "Archive" },
        { "output": "${ordersDir}\\main\\export\\Contoso.Orders.Export.exe", "args": ["--check"], "contains": "BatchSize = 750" },
        { "logged": "${logFile(status)}", "text": "Applied migration 2." },
        { "fileCount": "${ordersDir}\\main.backups", "pattern": "*", "equals": 1, "folders": true },
        { "lastLine": "${ordersDir}\\main\\logs\\heartbeat.log", "contains": "1.1.0 region west", "label": "Heartbeat" },
        { "lastLine": "${ordersDir}\\main\\logs\\heartbeat.log", "contains": "db schema 2", "label": "Heartbeat schema" }
      ],
      "look": [
        "Files review: order-confirmation.html tinted blue while kept.",
        "Config review: Region west kept, BatchSize 250, Smtp:Server renamed Smtp:Host, LegacyMode gone.",
        "Folder list: main v1.1.0, blue v1.0.0.",
        "Log: the API key shows as ****."
      ],
      "tools": [
        { "openFile": "${ordersDir}\\main\\appsettings.json" },
        { "openFile": "${ordersDir}\\main\\logs\\heartbeat.log", "label": "Heartbeat" },
        { "console": "& '${suiteDir}\\tools\\Show-Database.ps1' @args", "args": ["${ordersDir}\\main\\Contoso.Orders.exe", "${ordersData}\\db-main\\orders.db"], "label": "Database" },
        { "openFile": "${logFile(status)}", "label": "Log" },
        { "openFolder": "${ordersDir}\\main.backups", "label": "Backups" },
        { "console": "& '${suiteDir}\\tools\\Show-Services.ps1' @args", "args": ["Contoso.Orders"], "label": "Services" }
      ] }
  ]
}

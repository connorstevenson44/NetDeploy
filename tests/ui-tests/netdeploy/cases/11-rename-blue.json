{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Rename blue to green",
  "needs": ["upgrade-main"],
  "covers": "Changing an install's name, Rename, and removing the old install one step at a time",
  "steps": [
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\blue" } },
    { "type": "installName", "text": "green", "say": "Change the install's name to green" },
    { "find": { "button": "Rename" }, "say": "The button says Rename: blue is copied to green, 1.1.0 is installed there, and then blue can be removed." },
    { "click": { "button": "Rename" }, "say": "Click Rename" },
    { "call": "waitForReview", "with": { "title": "Check the files" } },
    { "call": "continuePastReview" },
    { "answerDialog": "NetDeploy", "button": "No", "expect": "Run a settings check on the old version first?", "say": "Say No to the optional settings check" },
    { "call": "waitForReview", "with": { "title": "Check the config" } },
    { "call": "showConfigFileDiff", "with": { "name": "appsettings.json" } },
    { "replaceText": "fileText", "regex": "(\"ApiKey\":\\s*)\"\"", "replacement": "$1\"${apiKey}\"", "say": "Fill in Payments:ApiKey" },
    { "call": "continuePastReview" },
    { "answerDialog": "Remove the old install", "button": "Yes", "expect": "Remove the old one", "within": 300, "say": "Yes, remove blue now that green works" },
    { "call": "stepThroughRemoval" },
    { "checkpoint": "blue is now green, on 1.1.0",
      "checks": [
        { "service": "Contoso.Orders-green", "state": "Running" },
        { "service": "Contoso.Orders-blue" },
        { "scheduledTask": "\\Contoso\\Orders Export-green" },
        { "scheduledTask": "\\Contoso\\Orders Export-blue", "exists": false },
        { "fileVersion": "${ordersDir}\\green\\Contoso.Orders.exe", "startsWith": "1.1.0" },
        { "fileMissing": "${ordersDir}\\blue" },
        { "fileExists": "${ordersData}\\db-green\\orders.db" },
        { "fileMissing": "${ordersData}\\db-blue" },
        { "service": "Contoso.Orders-main", "state": "Running" }
      ],
      "look": [
        "Each removal step said exactly what it would do before it ran.",
        "The folder list shows green and main, both on v1.1.0."
      ],
      "tools": [
        { "openFolder": "${ordersDir}", "label": "Install folder" },
        { "openFolder": "${ordersData}", "label": "Database folder" },
        { "console": "& '${suiteDir}\\tools\\Show-Services.ps1' @args", "args": ["Contoso.Orders"], "label": "Services" },
        { "console": "& '${suiteDir}\\tools\\Show-ScheduledTasks.ps1' @args", "args": ["\\Contoso\\"], "label": "Scheduled tasks" }
      ] }
  ]
}

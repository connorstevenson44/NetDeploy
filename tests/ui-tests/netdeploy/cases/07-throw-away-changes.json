{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Discard edits",
  "needs": ["edit-on-server"],
  "covers": "Undo all in the editor, and Discard for everything waiting to be written",
  "tags": ["files"],
  "steps": [
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\main" } },
    { "tab": "Files" },
    { "call": "openFileInEditor", "with": { "path": "appsettings.json" } },
    { "replaceText": "fileText", "regex": "(\"Region\":\\s*)\"west\"", "replacement": "$1\"north\"" },
    { "find": { "text": "1 change" } },
    { "click": { "button": "Undo all" } },
    { "waitGone": "finalize" },
    { "replaceText": "fileText", "regex": "(\"HeartbeatSeconds\":\\s*)10", "replacement": "$${1}30" },
    { "call": "clickFileRowButton", "with": { "path": "README.txt", "tip": "Delete when finalized" } },
    { "find": { "text": "1 change, 1 file to delete" } },
    { "click": { "button": "Discard" } },
    { "waitGone": "finalize" },
    { "checkpoint": "Nothing was written",
      "checks": [
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Orders:Region", "equals": "west" },
        { "jsonValue": "${ordersDir}\\main\\appsettings.json", "path": "Orders:HeartbeatSeconds", "equals": "10" },
        { "fileExists": "${ordersDir}\\main\\README.txt" }
      ],
      "look": [
        "Undo all took the Region edit out of the editor at once.",
        "Discard closed the file and uncrossed README.txt, without asking."
      ],
      "tools": [
        { "openFile": "${ordersDir}\\main\\appsettings.json" }
      ] }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Restore a backup",
  "needs": ["cancel-and-roll-back"],
  "covers": "An install's deploy history, a file lost on the server, and Restore beside a backup an earlier deploy made",
  "tags": ["backup"],
  "steps": [
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\blue" } },
    { "checkpoint": "History lists the rolled back upgrade",
      "checks": [
        { "shows": { "text": "1.1.0 stopped, rolled back" }, "within": 10, "label": "Newest deploy" }
      ] },
    { "delete": "${ordersDir}\\blue\\README.txt" },
    { "click": { "type": "Button", "helpText": "Put this backup back in place of the folder's files" }, "what": "Restore" },
    { "answerDialog": "Restore backup", "button": "Yes", "expect": "Put back the backup from" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Restored ", "within": "180" } },
    { "checkpoint": "blue is restored from the backup",
      "checks": [
        { "fileExists": "${ordersDir}\\blue\\README.txt" },
        { "fileVersion": "${ordersDir}\\blue\\Contoso.Orders.exe", "startsWith": "1.0.0" },
        { "service": "Contoso.Orders-blue", "state": "Running" }
      ],
      "look": [
        "HISTORY: the stopped upgrade first, with its time and who ran it.",
        "Restore asked first, and said the services would be stopped and started.",
        "Log tab: service stopped, files put back, service started."
      ],
      "tools": [
        { "openFolder": "${ordersDir}\\blue", "label": "blue" },
        { "openFolder": "${ordersDir}\\blue.backups", "label": "Backups" },
        { "console": "& '${suiteDir}\\tools\\Show-Services.ps1' @args", "args": ["Contoso.Orders"], "label": "Services" }
      ] }
  ]
}

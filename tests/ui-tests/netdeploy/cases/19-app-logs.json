{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Read, follow and search app logs",
  "needs": ["upgrade-main"],
  "covers": "The App logs tab for an app with an nlog.config: the live log growing, search highlighting, a regular expression, and Search all marking the zipped archive that matches",
  "tags": ["logs"],
  "steps": [
    { "script": "tools/Add-AppLogs.ps1", "args": ["${ordersDir}\\main"] },
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\main" } },
    { "tab": "App logs" },
    { "find": "logText", "as": "live" },
    { "find": { "button": "heartbeat.log" } },
    { "waitText": "logText", "changes": true, "within": 45 },
    { "type": "searchLog", "text": "region" },
    { "waitText": "matchCount", "contains": " of ", "as": "first" },
    { "click": { "button": "Next match" } },
    { "click": { "button": "Regular expression" } },
    { "type": "searchLog", "text": "ORD-10\\d+" },
    { "waitText": "matchCount", "contains": "No matches", "as": "none" },
    { "click": { "button": "Search all" } },
    { "waitText": { "id": "SearchStatus" }, "contains": "Found in", "within": 60, "as": "searched" },
    { "checkpoint": "Search all marks the logs",
      "checks": [
        { "equals": "${searched}", "to": "Found in 1 of 3 logs", "label": "Search all" },
        { "shows": { "button": "heartbeat.1.log, no matches" }, "within": 5, "label": "heartbeat.1.log" },
        { "shows": { "button": "heartbeat.2.log in heartbeat.2.zip, 2 matches" }, "within": 5, "label": "heartbeat.2.zip" }
      ] },
    { "click": { "button": "heartbeat.2.log in heartbeat.2.zip, 2 matches" }, "what": "heartbeat.2.log" },
    { "waitText": "logText", "contains": "ORD-1042", "as": "opened" },
    { "checkpoint": "The app's logs can be read, followed and searched",
      "checks": [
        { "contains": "${live.value}", "text": "region", "label": "Live log" },
        { "matches": "${first}", "regex": "^1 of \\d", "label": "Matches for region" },
        { "equals": "${none}", "to": "No matches", "label": "Matches for ORD-10\\d+" },
        { "contains": "${opened.value}", "text": "ORD-1042 payment declined", "label": "Zipped log" }
      ],
      "look": [
        "A new heartbeat line showed by itself.",
        "Logs list: LIVE heartbeat.log; ARCHIVED heartbeat.1.log and heartbeat.2.log in heartbeat.2.zip.",
        "heartbeat.2.log has a yellow 2; heartbeat.1.log and heartbeat.log are faded.",
        "Both ORD-1042 highlighted, the first in orange; the box says 1 of 2.",
        "Lines coloured by level, such as ERROR in red."
      ],
      "tools": [
        { "openFolder": "${ordersDir}\\main\\logs", "label": "Logs folder" },
        { "openFile": "${ordersDir}\\main\\nlog.config" }
      ] }
  ]
}

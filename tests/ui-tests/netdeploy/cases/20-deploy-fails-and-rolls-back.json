{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Failed deploy rolls back",
  "needs": ["clone-main"],
  "covers": "A step failing during a real deploy, the roll back offer, Roll back restoring the backup, and the failure in the history",
  "tags": ["deploy", "rollback"],
  "steps": [
    { "unzip": "${packages}\\Contoso.Orders-1.1.0.zip", "to": "${temp}\\failing" },
    { "script": "tools/Add-FailingStep.ps1", "args": ["${temp}\\failing\\deploy.json"] },
    { "note": "The deploy deletes files the package doesn't have, so this comes back only if the roll back works.",
      "writeFile": "${ordersDir}\\qa\\notes-from-support.txt", "text": "Left here by hand, to see a roll back put it back" },
    { "click": { "button": "Open config" } },
    { "pickFile": "Open a deploy config", "path": "${temp}\\failing\\deploy.json" },
    { "call": "waitForHeader", "with": { "title": "Contoso.Orders 1.2.0" } },
    { "type": { "edit": "Payments API key (new in 1.1)" }, "text": "${apiKey}", "secret": true },
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\qa" } },
    { "click": { "button": "Update" } },
    { "call": "waitForReview", "with": { "title": "Check the files" } },
    { "call": "continuePastReview" },
    { "answerDialog": "NetDeploy", "button": "No", "expect": "Run a settings check on the old version first?" },
    { "call": "waitForReview", "with": { "title": "Check the config" } },
    { "call": "continuePastReview" },
    { "answerDialog": "Roll back", "button": "Yes", "expect": "Failed at \"Warm up the cache\"", "within": 300, "as": "failure" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Rolled back to the backup.", "within": "120" } },
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\qa" } },
    { "checkpoint": "qa is back as before the failed deploy",
      "checks": [
        { "contains": "${failure}", "text": "Restore the backup and restart the services this deploy stopped?", "label": "Roll back offer" },
        { "shows": { "text": "1.2.0 failed, rolled back" }, "within": 10, "label": "HISTORY" },
        { "fileExists": "${ordersDir}\\qa\\notes-from-support.txt" },
        { "service": "Contoso.Orders-qa", "state": "Running" },
        { "fileVersion": "${ordersDir}\\qa\\Contoso.Orders.exe", "startsWith": "1.1.0" },
        { "jsonValue": "${ordersDir}\\qa\\appsettings.json", "path": "Payments:ApiKey", "equals": "${apiKey}" },
        { "jsonValue": "${ordersDir}\\qa\\appsettings.json", "path": "Orders:Region", "equals": "west" },
        { "lastLine": "${ordersDir}\\qa\\logs\\heartbeat.log", "contains": "1.1.0", "label": "Heartbeat" }
      ],
      "look": [
        "The roll back question named Warm up the cache and its error.",
        "Log tab: the step's error, then the backup put back and the service started."
      ],
      "tools": [
        { "openFolder": "${ordersDir}\\qa", "label": "qa" },
        { "openFile": "${temp}\\failing\\deploy.json", "label": "Failing deploy.json" },
        { "console": "& '${suiteDir}\\tools\\Show-Services.ps1' @args", "args": ["Contoso.Orders"], "label": "Services" }
      ] }
  ]
}

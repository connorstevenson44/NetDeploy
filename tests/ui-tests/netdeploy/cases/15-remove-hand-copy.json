{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Remove a hand-copied install",
  "needs": ["upgrade-main"],
  "covers": "A folder copied outside NetDeploy showing as an install, and Skip this step for what it never had",
  "tags": ["remove"],
  "steps": [
    { "note": "Copy-Item rather than a copy step: main's service has its heartbeat log open, and the copy carries on without it.",
      "powershell": ["$from, $to = $args", "if (Test-Path -LiteralPath $to) { Remove-Item -LiteralPath $to -Recurse -Force }", "Copy-Item -LiteralPath $from -Destination $to -Recurse -ErrorAction SilentlyContinue"], "args": ["${ordersDir}\\main", "${ordersDir}\\spare"] },
    { "call": "goUpToInstallFolder" },
    { "click": "refresh", "what": "Refresh" },
    { "checkpoint": "spare shows as an install without a service",
      "checks": [
        { "shows": { "text": "No Windows service runs from this install", "within": { "element": "folderRow", "with": { "path": "${ordersDir}\\spare" } } },
          "within": 10, "label": "spare's service sign" }
      ] },
    { "note": "Only the last step, deleting the folder, applies to a copy: it never had a service, a task or a database.", "call": "removeInstall", "with": { "path": "${ordersDir}\\spare", "choice": "lastOnly" } },
    { "checkpoint": "spare is gone, main untouched",
      "checks": [
        { "fileMissing": "${ordersDir}\\spare" },
        { "service": "Contoso.Orders-spare" },
        { "service": "Contoso.Orders-main", "state": "Running" },
        { "fileExists": "${ordersDir}\\main\\Contoso.Orders.exe" },
        { "fileExists": "${ordersData}\\db-main\\orders.db" }
      ],
      "look": [
        "Folder list: spare showed v1.1.0 and a question mark.",
        "Log tab: every step but deleting the folder skipped."
      ],
      "tools": [
        { "openFolder": "${ordersDir}", "label": "Install folder" },
        { "console": "& '${suiteDir}\\tools\\Show-Services.ps1' @args", "args": ["Contoso.Orders"], "label": "Services" }
      ] }
  ]
}

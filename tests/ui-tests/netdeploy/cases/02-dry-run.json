{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Dry run a new install",
  "needs": ["open-package"],
  "covers": "Naming a new install, Dry run, the file and config reviews, the summary of changes, and nothing written",
  "tags": ["deploy", "dry-run"],
  "steps": [
    { "type": "newInstallName", "text": "main" },
    { "click": { "button": "Dry run" } },
    { "call": "waitForReview", "with": { "title": "Check the files" } },
    { "find": { "text": "Dry run: nothing will change" } },
    { "call": "continuePastReview" },
    { "call": "waitForReview", "with": { "title": "Check the config" } },
    { "repeat": ["appsettings.json", "appsettings.Production.json", "Contoso.Orders.Export.exe.config"],
      "steps": [ { "call": "showConfigFileDiff", "with": { "name": "${item}" } } ] },
    { "call": "continuePastReview" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Dry run finished." }, "as": "status" },
    { "find": { "text": "Dry run: what the deploy would change" } },
    { "hover": { "text": "Files: ", "match": "startsWith" }, "as": "files" },
    { "checkpoint": "Dry run changed nothing",
      "checks": [
        { "fileMissing": "${ordersDir}" },
        { "fileMissing": "${ordersData}" },
        { "service": "Contoso.Orders-main" },
        { "fileExists": "${logFile(status)}" },
        { "matches": "${files}", "regex": "^Files: [1-9]\\d* added, 0 replaced, 0 deleted\\.$", "label": "Files summary" },
        { "shows": { "button": "Add" }, "label": "Deploy button" }
      ],
      "look": [
        "Summary above the log: the service, the scheduled task and the scripts it would run.",
        "Log tab: each step and what it would have done.",
        "Steps tab: every step marked done or skipped."
      ],
      "tools": [
        { "openFile": "${logFile(status)}", "label": "Log" }
      ] }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Start, stop and restart main's service",
  "needs": ["add-main"],
  "covers": "A service stopped outside NetDeploy and Refresh, then Start, Stop and Restart on an install's row, with the dot following",
  "tags": ["service"],
  "steps": [
    { "call": "goUpToInstallFolder" },
    { "stopService": "Contoso.Orders-main" },
    { "click": "refresh", "what": "Refresh" },
    { "checkpoint": "Refresh shows the service stopped",
      "checks": [
        { "shows": { "text": "Contoso.Orders-main: stopped", "match": "contains" }, "within": 10, "label": "main's dot" }
      ] },
    { "call": "clickInstallRowButton", "with": { "path": "${ordersDir}\\main", "tip": "Start its services" } },
    { "call": "waitForStatusBar", "with": { "startsWith": "Contoso.Orders-main: start done.", "within": "120" } },
    { "call": "clickInstallRowButton", "with": { "path": "${ordersDir}\\main", "tip": "Stop its services" } },
    { "answerDialog": "Stop service", "button": "Yes", "expect": "Stop Contoso.Orders-main?" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Contoso.Orders-main: stop done.", "within": "120" } },
    { "checkpoint": "Stop stops the service",
      "checks": [
        { "service": "Contoso.Orders-main", "state": "Stopped" },
        { "shows": { "text": "Contoso.Orders-main: stopped", "match": "contains" }, "within": 10, "label": "main's dot" }
      ] },
    { "call": "clickInstallRowButton", "with": { "path": "${ordersDir}\\main", "tip": "Start its services" } },
    { "call": "waitForStatusBar", "with": { "startsWith": "Contoso.Orders-main: start done.", "within": "120" } },
    { "call": "clickInstallRowButton", "with": { "path": "${ordersDir}\\main", "tip": "Restart its services" } },
    { "answerDialog": "Restart service", "button": "Yes", "expect": "Restart Contoso.Orders-main?" },
    { "call": "waitForStatusBar", "with": { "startsWith": "Contoso.Orders-main: restart done.", "within": "120" } },
    { "checkpoint": "main's service is running after Restart",
      "checks": [
        { "service": "Contoso.Orders-main", "state": "Running" },
        { "shows": { "text": "Contoso.Orders-main: running", "match": "contains" }, "within": 10, "label": "main's dot" },
        { "lastLine": "${ordersDir}\\main\\logs\\heartbeat.log", "contains": "1.0.0", "label": "Heartbeat" }
      ],
      "look": [
        "Stop and Restart asked first; Start didn't."
      ],
      "tools": [
        { "console": "& '${suiteDir}\\tools\\Show-Services.ps1' @args", "args": ["Contoso.Orders"], "label": "Services" }
      ] }
  ]
}

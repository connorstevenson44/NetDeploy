{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Reopen from Recent",
  "needs": ["clone-main"],
  "covers": "The start screen's Recent list, a package reopening with its install folder and each install's last settings, and the same-version sign",
  "tags": ["settings"],
  "steps": [
    { "startApp": {} },
    { "find": { "text": "RECENT" } },
    { "click": { "button": "Contoso.Orders-1.1.0.zip" } },
    { "call": "waitForHeader", "with": { "title": "Contoso.Orders 1.1.0" } },
    { "find": { "edit": "Install folder" }, "as": "folder" },
    { "call": "goUpToInstallFolder" },
    { "checkpoint": "main is marked as the same version",
      "checks": [
        { "shows": { "text": "The package is the same version (1.1.0).", "within": { "element": "folderRow", "with": { "path": "${ordersDir}\\main" } } },
          "within": 10, "label": "main's version sign" }
      ] },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\green" } },
    { "find": "environment", "as": "green" },
    { "call": "goUpToInstallFolder" },
    { "call": "openFolderInList", "with": { "path": "${ordersDir}\\main" } },
    { "find": "environment", "as": "main" },
    { "checkpoint": "NetDeploy remembered what was open and each install's settings",
      "checks": [
        { "equals": "${folder.value}", "to": "${ordersDir}", "label": "Install folder" },
        { "equals": "${green.selection}", "to": "Production", "label": "green's environment" },
        { "equals": "${main.selection}", "to": "Staging", "label": "main's environment" },
        { "shows": { "text": "Reinstall main" }, "within": 10, "label": "Plan" },
        { "fileExists": "${settingsFile}" },
        { "fileCount": "${ordersDir}", "pattern": "settings.json", "equals": 0, "recursive": true, "label": "settings.json in an install" },
        { "fileCount": "${folderOf(exe)}", "pattern": "settings.json", "equals": 0, "label": "settings.json beside NetDeploy.exe" }
      ],
      "look": [
        "Recent: the packages, C:\\Apps\\Contoso.Orders and the editor folder, newest first.",
        "The payments API key box is empty."
      ],
      "tools": [
        { "openFile": "${settingsFile}", "label": "settings.json" }
      ] }
  ]
}

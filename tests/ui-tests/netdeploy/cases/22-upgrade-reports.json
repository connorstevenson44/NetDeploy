{
  "$schema": "https://raw.githubusercontent.com/connorstevenson44/AutoTestRunner/main/schema/case.schema.json",
  "name": "Upgrade Fabrikam.Reports to 2.1.0",
  "needs": ["add-reports"],
  "covers": "Settings changed by hand on the server, a tick box setting, merging .NET Framework settings files, and swapped plugins",
  "tags": ["upgrade", "net-framework"],
  "steps": [
    { "setAppSetting": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "key": "ReportTitle", "to": "Fabrikam weekly sales" },
    { "setAppSetting": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "key": "KeepReports", "to": "45" },
    { "setAppSetting": "${reportsDir}\\main\\wwwroot\\web.config", "key": "AllowDownload", "to": "false" },
    { "call": "openPackage", "with": { "zip": "${packages}\\Fabrikam.Reports-2.1.0.zip" } },
    { "call": "waitForHeader", "with": { "title": "Fabrikam.Reports 2.1.0" } },
    { "tick": { "checkBox": "Publish the report site" }, "checked": true },
    { "click": { "button": "Update" } },
    { "call": "waitForReview", "with": { "title": "Check the files" } },
    { "hover": { "element": "fileName", "with": { "path": "plugins/Fabrikam.Reports.Pdf.dll" } }, "what": "Fabrikam.Reports.Pdf.dll" },
    { "hover": { "element": "fileName", "with": { "path": "plugins/Fabrikam.Reports.Excel.dll" } }, "what": "Fabrikam.Reports.Excel.dll" },
    { "call": "continuePastReview" },
    { "call": "waitForReview", "with": { "title": "Check the config" } },
    { "call": "showConfigFileDiff", "with": { "name": "Fabrikam.Reports.exe.config" } },
    { "call": "showConfigFileDiff", "with": { "name": "web.config" } },
    { "call": "continuePastReview" },
    { "answerDialog": "NetDeploy", "button": "Yes", "expect": "Run a report now to check the install?", "within": 120 },
    { "find": { "window": "Schedule the hourly report" }, "within": 120 },
    { "call": "continueInputsWindow", "with": { "title": "Schedule the hourly report" } },
    { "call": "waitForStatusBar", "with": { "startsWith": "Deploy finished.", "within": "300" }, "as": "status" },
    { "checkpoint": "Fabrikam.Reports is on 2.1.0 with the server's edits",
      "checks": [
        { "logged": "${logFile(status)}", "text": "left as it is" },
        { "logged": "${logFile(status)}", "text": "plugins: csv, xlsx" },
        { "logged": "${logFile(status)}", "text": "Check passed." },
        { "fileMissing": "${reportsDir}\\main\\plugins\\Fabrikam.Reports.Pdf.dll" },
        { "fileCount": "${reportsDir}\\main\\reports", "pattern": "*.xlsx", "equals": 1 },
        { "appSetting": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "key": "ReportTitle", "equals": "Fabrikam weekly sales" },
        { "appSetting": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "key": "KeepReports", "equals": "90" },
        { "appSetting": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "key": "LegacyPdfEngine", "equals": "<absent>" },
        { "connectionString": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "name": "Audit" },
        { "fileContains": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "text": "newVersion=\"13.0.0.0\"", "label": "Binding redirect" },
        { "appSetting": "${reportsDir}\\main\\wwwroot\\web.config", "key": "AllowDownload", "equals": "false" },
        { "appSetting": "${reportsDir}\\main\\wwwroot\\web.config", "key": "PageSize", "equals": "25" }
      ],
      "look": [
        "Files review: the PDF plugin crossed out, the Excel one new.",
        "Config review: ReportTitle kept, KeepReports 90, MaxRows new, LegacyPdfEngine gone; web.config keeps AllowDownload, gets PageSize.",
        "reports: the first report as .pdf, the new one as .xlsx."
      ],
      "tools": [
        { "openFile": "${reportsDir}\\main\\Fabrikam.Reports.exe.config", "label": ".exe.config" },
        { "openFile": "${reportsDir}\\main\\wwwroot\\web.config", "label": "web.config" },
        { "openFolder": "${reportsDir}\\main\\reports", "label": "reports" },
        { "openFile": "${logFile(status)}", "label": "Log" }
      ] }
  ]
}

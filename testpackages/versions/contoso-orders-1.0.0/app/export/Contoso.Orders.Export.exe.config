<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="ExportFolder" value="exports" />
    <add key="BatchSize" value="500" />
    <add key="Format" value="csv" />
    <add key="IncludeCancelled" value="false" />
  </appSettings>
  <connectionStrings>
    <add name="Orders" connectionString="Data Source=orders.db" />
  </connectionStrings>
</configuration>

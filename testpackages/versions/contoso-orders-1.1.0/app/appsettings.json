{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.Hosting.Lifetime": "Warning", "Contoso.Orders": "Debug" }
  },
  "Orders": {
    "Region": "east",
    "BatchSize": 250,
    "HeartbeatSeconds": 10
  },
  "Smtp": {
    "Host": "smtp.contoso.local",
    "Port": 587,
    "From": "orders@contoso.local",
    "UseTls": true
  },
  "Cleanup": { "KeepDays": 30 },
  "Payments": {
    "Provider": "Stripe",
    "ApiKey": ""
  },
  "Features": {
    "FastCheckout": true,
    "Returns": true
  },
  "ConnectionStrings": {
    "Orders": "Data Source=orders.db"
  }
}

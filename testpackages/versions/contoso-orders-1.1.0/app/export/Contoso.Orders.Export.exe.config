<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="ExportFolder" value="exports" />
    <add key="BatchSize" value="1000" />
    <add key="Format" value="json" />
    <add key="Compress" value="true" />
  </appSettings>
  <connectionStrings>
    <add name="Orders" connectionString="Data Source=orders.db" />
    <add name="Archive" connectionString="Data Source=archive.db" />
  </connectionStrings>
</configuration>

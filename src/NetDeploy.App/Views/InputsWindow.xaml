<Window x:Class="NetDeploy.App.Views.InputsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource AppWindow}" Background="{StaticResource Surface}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <!-- A step's questions, asked as it runs. Laid out like the workspace's panes: a header, the form, and a footer bar. -->
    <StackPanel>
        <DockPanel Margin="24,22,24,0">
            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource BrandTint}" VerticalAlignment="Top" Margin="0,0,14,0">
                <materialDesign:PackIcon Kind="ClipboardEditOutline" Foreground="{StaticResource Brand}" Width="20" Height="20"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PanelTitle}" TextWrapping="Wrap" />
                <TextBlock Text="Fill these in to continue." Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="24,20,24,6" />
        <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource QuietButton}" Content="Cancel deploy" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Continue" IsDefault="True" Click="OnContinue"
                        Tag="{x:Static materialDesign:PackIconKind.ArrowRight}" ContentTemplate="{StaticResource IconLabel}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>

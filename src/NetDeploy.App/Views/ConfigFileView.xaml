<UserControl x:Class="NetDeploy.App.Views.ConfigFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:config="clr-namespace:NetDeploy.Core.Config;assembly=NetDeploy.Core"
             xmlns:controls="clr-namespace:NetDeploy.App.Controls">
    <!-- One file in a track-changes editor, like a word processor's: the file as it will be written, editable, with
         new text on green and the server's text that goes struck through in red where it was. Each change has buttons
         at the end of its line to undo it or take the package's text. Settings that need a value are listed above.
         DataContext is a ConfigFileViewModel; set IsReadOnly to show it without editing. -->
    <UserControl.Resources>
        <FontFamily x:Key="Code">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="EditableOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A labelled button that settles a setting, in the list of settings that need a value -->
        <DataTemplate x:Key="ChoiceButton">
            <Button Command="{Binding Command}" ToolTip="{Binding Tip}" Height="26" Padding="8,0" Margin="4,0,0,0" FontSize="12"
                    Style="{StaticResource QuietButton}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Tip}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Totals of the changes, a way to step through them, and undo -->
        <DockPanel DockPanel.Dock="Top" Margin="12,4,8,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource QuietButton}" Height="30" Width="34" Padding="0" Click="OnPreviousChange" ToolTip="Previous change"
                        AutomationProperties.Name="Previous change">
                    <materialDesign:PackIcon Kind="ChevronUp" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource QuietButton}" Height="30" Width="34" Padding="0" Click="OnNextChange" ToolTip="Next change"
                        AutomationProperties.Name="Next change">
                    <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" />
                </Button>
                <Button Command="{Binding UndoAllCommand}" Height="30" Padding="10,0" Margin="4,0,0,0" Content="Undo all"
                        Tag="{x:Static materialDesign:PackIconKind.UndoVariant}" ContentTemplate="{StaticResource IconLabel}"
                        ToolTip="{Binding UndoAllTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Code}" TextElement.FontSize="12">
                <TextBlock Foreground="{StaticResource Success}" Margin="0,0,14,0" ToolTip="Changes that add text"><Run Text="+" /><Run Text="{Binding AddedCount, Mode=OneWay}" /></TextBlock>
                <TextBlock Foreground="{StaticResource Danger}" Margin="0,0,14,0" ToolTip="Changes that take text out"><Run Text="−" /><Run Text="{Binding RemovedCount, Mode=OneWay}" /></TextBlock>
                <TextBlock Foreground="{StaticResource Brand}" Margin="0,0,14,0" ToolTip="Changes that replace text"><Run Text="~" /><Run Text="{Binding ModifiedCount, Mode=OneWay}" /></TextBlock>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="{StaticResource Warning}" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConflictText}" Foreground="{StaticResource Warning}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="NewFileNote" Text="New file: written as shown" Foreground="{StaticResource InkMuted}" FontFamily="{StaticResource {x:Static SystemFonts.MessageFontFamilyKey}}"
                           VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigFileKind.New}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Settings that need a value, each with the ways to settle it. Typing a value in the text settles it too. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WarningTint}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="12,4"
                Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Choices}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ChoiceButton}" Focusable="False"
                                          Style="{StaticResource EditableOnly}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="{StaticResource Warning}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"><Run Text="{Binding Path, Mode=OneWay}" FontFamily="{StaticResource Code}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Reason, Mode=OneWay}" Foreground="{StaticResource InkMuted}" /></TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Why the text can't be read as settings yet, on one line so the text stays in view, with a way to go to it -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource DangerTint}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="12,2"
                Visibility="{Binding HasTextError, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Height="26" Padding="8,0" Margin="8,0,0,0" FontSize="12" Content="Show"
                        Click="OnShowTextError" ToolTip="Put the cursor where the text goes wrong" AutomationProperties.Name="Show the problem"
                        Visibility="{Binding TextProblem.Offset, Converter={StaticResource NullToCollapsed}}" />
                <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{StaticResource Danger}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="TextError" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource Danger}" VerticalAlignment="Center"
                           ToolTip="{Binding TextError}" Margin="0,4"><Run Text="Fix the text before it can be written: " /><Run Text="{Binding TextError, Mode=OneWay}" /></TextBlock>
            </DockPanel>
        </Border>

        <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
            <controls:ChangeEditor x:Name="Editor" BoundText="{Binding Text}" Marks="{Binding Marks}" FileName="{Binding FileName}"
                              IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Foreground="{StaticResource Ink}" Background="{StaticResource Surface}" LineNumbersForeground="{StaticResource InkFaint}"
                              AutomationProperties.Name="{Binding FileName, StringFormat=The text of {0}}" />
        </Border>
    </DockPanel>
</UserControl>

<Window x:Class="NetDeploy.App.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:NetDeploy.App.ViewModels"
        Style="{StaticResource AppWindow}"
        Title="Merge settings" Height="720" Width="1240" MinWidth="860" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Brand}" Padding="24,16">
            <DockPanel>
                <materialDesign:PackIcon Kind="SourceMerge" Foreground="White" Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel>
                    <TextBlock Text="MERGE SETTINGS" Foreground="White" Opacity="0.75" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FilePath}" Foreground="White" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" Foreground="White" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <CheckBox Content="Show unchanged settings" IsChecked="{Binding ShowUnchanged}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource QuietButton}" Content="Cancel deploy" IsCancel="True" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ApplyText}" IsDefault="True" IsEnabled="{Binding CanApply}" Click="OnApply" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0">
            <Border Background="{StaticResource WarningTint}" CornerRadius="8" Padding="14,8" Margin="0,0,0,10"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Dry run: this shows how the file would be merged. Nothing will be written." Foreground="{StaticResource Warning}" />
            </Border>
            <TextBlock Style="{StaticResource Caption}" FontSize="13"
                       Text="Pick a choice for each row, or type in the Result column to set your own value. Red rows changed on both sides and need a choice." />
        </StackPanel>

        <materialDesign:Card Style="{StaticResource Panel}" Padding="0" Margin="24,12,24,20">
            <DataGrid x:Name="RowsGrid" ItemsSource="{Binding RowsView}" Background="{StaticResource Surface}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Hairline}"
                      SelectionMode="Single" IsReadOnly="{Binding IsReadOnly}" RowHeaderWidth="0">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True" Margin="0,4,0,0">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}" Foreground="{StaticResource InkMuted}" FontWeight="Normal" />
                                                        </TextBlock>
                                                        <Button Content="Keep all current" Style="{StaticResource MaterialDesignFlatButton}" Height="28" Margin="16,0,0,0" Padding="8,0"
                                                                Command="{Binding DataContext.KeepAllCurrentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding Name}" />
                                                        <Button Content="Take all incoming" Style="{StaticResource MaterialDesignFlatButton}" Height="28" Margin="4,0,0,0" Padding="8,0"
                                                                Command="{Binding DataContext.TakeAllIncomingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding Name}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NeedsChoice}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerTint}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Setting" Binding="{Binding Path, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Header="Server (current)" Binding="{Binding CurrentText, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Header="Package (incoming)" Binding="{Binding IncomingText, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                    <DataGridTemplateColumn Header="Choice" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{x:Static vm:MergeRowViewModel.Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Choice, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Result" Binding="{Binding ResultText}" Width="2*" />
                    <DataGridTextColumn Header="Why" Binding="{Binding Reason, Mode=OneWay}" IsReadOnly="True" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </DockPanel>
</Window>

<Window x:Class="NetDeploy.App.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:NetDeploy.App.ViewModels"
        xmlns:config="clr-namespace:NetDeploy.Core.Config;assembly=NetDeploy.Core"
        xmlns:app="clr-namespace:NetDeploy.App"
        Style="{StaticResource AppWindow}"
        Title="Config files" Height="780" Width="1280" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Brand}" Padding="24,14">
            <DockPanel>
                <materialDesign:PackIcon Kind="FileCogOutline" Foreground="White" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,14,0" />
                <!-- Counts for the whole review -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="White">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0" ToolTip="Settings that need you before the files can be written"
                                Visibility="{Binding ConflictCount, Converter={StaticResource NonZeroToVisible}}">
                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="#FFD54F" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConflictCount}" FontSize="15" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Settings that change">
                        <materialDesign:PackIcon Kind="SyncCircle" Width="18" Height="18" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ChangeCount}" FontSize="15" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CHECK CONFIG" Foreground="White" Opacity="0.75" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="24,10">
            <DockPanel>
                <ToggleButton Style="{StaticResource MaterialDesignFlatToggleButton}" IsChecked="{Binding ShowUnchanged}" Width="36" Height="36"
                              ToolTip="Show unchanged settings">
                    <materialDesign:PackIcon Kind="EyeOutline" Width="20" Height="20" />
                </ToggleButton>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource QuietButton}" Content="Cancel deploy" IsCancel="True" Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ApplyText}" IsDefault="True" IsEnabled="{Binding CanApply}"
                            Click="OnApply" Tag="{x:Static materialDesign:PackIconKind.ContentSaveCheck}" ContentTemplate="{StaticResource IconLabel}"
                            ToolTip="Every setting marked with a yellow icon needs a value first" ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource WarningTint}" CornerRadius="8" Padding="14,8" Margin="24,14,24,0"
                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="EyeOutline" Foreground="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="Dry run: nothing will be written." Foreground="{StaticResource Warning}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Margin="24,14,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The files -->
            <materialDesign:Card Style="{StaticResource Panel}" Padding="0">
                <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Padding="6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="ToolTip" Value="{Binding Folder}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigFileViewModel}">
                            <DockPanel>
                                <materialDesign:PackIcon x:Name="KindIcon" DockPanel.Dock="Left" Kind="FileSyncOutline" Width="20" Height="20"
                                                         Foreground="{StaticResource Brand}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                         Background="Transparent" ToolTip="{Binding KindTip}" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" ToolTip="Need you"
                                                Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="{StaticResource Warning}" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConflictCount}" FontSize="11" Foreground="{StaticResource Warning}" Margin="3,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" ToolTip="Changes"
                                                Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                                        <materialDesign:PackIcon Kind="SyncCircle" Foreground="{StaticResource Brand}" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ChangeCount}" FontSize="11" Foreground="{StaticResource Brand}" Margin="3,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigFileKind.New}">
                                    <Setter TargetName="KindIcon" Property="Kind" Value="FilePlusOutline" />
                                    <Setter TargetName="KindIcon" Property="Foreground" Value="{StaticResource Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigFileKind.Override}">
                                    <Setter TargetName="KindIcon" Property="Kind" Value="LayersOutline" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </materialDesign:Card>

            <!-- The selected file, side by side -->
            <materialDesign:Card Grid.Column="2" Style="{StaticResource Panel}" Padding="0" DataContext="{Binding SelectedFile}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,12,12,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding KeepAllNowCommand}" Width="34" Height="34"
                                    ToolTip="Keep every value that is there now">
                                <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="18" Height="18" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding ResetAllCommand}" Width="34" Height="34"
                                    ToolTip="Use every package value">
                                <materialDesign:PackIcon Kind="Undo" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" ToolTip="{Binding Folder}" />
                    </DockPanel>
                    <app:ConfigFileView IsReadOnly="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </DockPanel>
</Window>

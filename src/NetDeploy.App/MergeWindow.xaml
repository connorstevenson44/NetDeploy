<Window x:Class="NetDeploy.App.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetDeploy.App.ViewModels"
        Title="Merge settings" Height="680" Width="1200" MinWidth="800" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding FilePath}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Summary}" Foreground="#5F6368" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock Text="Dry run: this shows how the file would be merged. Nothing will be written."
                       Foreground="#8A6100" Margin="0,4,0,0"
                       Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Foreground="#5F6368" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Pick a choice for each row, or type in the Result column to set your own value. Red rows changed on both sides and need a choice." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <CheckBox Content="Show unchanged settings" IsChecked="{Binding ShowUnchanged}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding ApplyText}" IsDefault="True" IsEnabled="{Binding CanApply}" Click="OnApply" Margin="0,0,8,0" />
                <Button Content="Cancel deploy" IsCancel="True" />
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="RowsGrid" ItemsSource="{Binding RowsView}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8EAED"
                  SelectionMode="Single" IsReadOnly="{Binding IsReadOnly}" RowHeaderWidth="0">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Expander IsExpanded="True" Margin="0,4,0,0">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}" Foreground="#5F6368" FontWeight="Normal" />
                                                    </TextBlock>
                                                    <Button Content="Keep all current" Margin="16,0,0,0" Padding="8,1" MinWidth="0"
                                                            Command="{Binding DataContext.KeepAllCurrentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding Name}" />
                                                    <Button Content="Take all incoming" Margin="6,0,0,0" Padding="8,1" MinWidth="0"
                                                            Command="{Binding DataContext.TakeAllIncomingCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding Name}" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChanged}" Value="False">
                            <Setter Property="Foreground" Value="#9AA0A6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NeedsChoice}" Value="True">
                            <Setter Property="Background" Value="#FCE8E6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Setting" Binding="{Binding Path, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="Server (current)" Binding="{Binding CurrentText, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                <DataGridTextColumn Header="Package (incoming)" Binding="{Binding IncomingText, Mode=OneWay}" IsReadOnly="True" Width="2*" />
                <DataGridTemplateColumn Header="Choice" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static vm:MergeRowViewModel.Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Choice, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Result" Binding="{Binding ResultText}" Width="2*" />
                <DataGridTextColumn Header="Why" Binding="{Binding Reason, Mode=OneWay}" IsReadOnly="True" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

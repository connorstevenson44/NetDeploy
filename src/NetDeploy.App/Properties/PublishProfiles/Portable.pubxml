<Project>
  <!-- One self-contained exe that runs on any Windows x64 machine with nothing installed:
       dotnet publish src/NetDeploy.App -p:PublishProfile=Portable -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Leaves out the .pdb files of referenced projects, so the folder holds only the exe. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\artifacts\portable\</PublishDir>
  </PropertyGroup>
</Project>

<Window x:Class="NetDeploy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:core="clr-namespace:NetDeploy.Core;assembly=NetDeploy.Core"
        xmlns:config="clr-namespace:NetDeploy.Core.Config;assembly=NetDeploy.Core"
        xmlns:app="clr-namespace:NetDeploy.App"
        xmlns:vm="clr-namespace:NetDeploy.App.ViewModels"
        Style="{StaticResource AppWindow}"
        Title="NetDeploy" Height="820" Width="1320" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        Closing="OnClosing">
    <!-- One workspace. Left: the package's settings and the install folder's tree. Right: tabs for the files of the
         folder picked in the tree, the steps, the deploy config and the log; while a deploy waits for the user, its
         review takes the tabs' place. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FileTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A toolbar button on the brand bar -->
            <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="ContentTemplate" Value="{StaticResource IconLabel}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
                <Setter Property="materialDesign:RippleAssist.Feedback" Value="White" />
            </Style>

            <!-- A small icon button in a pane's header -->
            <Style x:Key="PaneButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            </Style>
            <Style x:Key="PaneToggle" TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignFlatToggleButton}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
            </Style>

            <!-- A pill, for "Dry run" -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brand}" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="8,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextElement.Foreground" Value="White" />
                <Setter Property="TextElement.FontSize" Value="11" />
                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            </Style>

            <!-- A tab's header: an icon and a name -->
            <DataTemplate x:Key="TabHeader">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                             Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>

            <!-- The log -->
            <Style x:Key="LogList" TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}">
                <Setter Property="ItemsSource" Value="{Binding Log}" />
                <Setter Property="FontFamily" Value="{StaticResource Code}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="8,1" />
                            <Setter Property="materialDesign:ListBoxItemAssist.ShowSelection" Value="False" />
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Time, Mode=OneWay, StringFormat=HH:mm:ss}" Foreground="{StaticResource InkFaint}" />
                                <Run Text="  " />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogLevel.Warning}">
                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogLevel.Error}">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== The folder view: the folders in the one it is in ===== -->

            <!-- A row to click: a folder to go into, or the new install to pick -->
            <Style x:Key="FolderRow" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
            </Style>

            <!-- Start, stop and restart its services, clone and remove for an install, shown on hover -->
            <DataTemplate x:Key="InstallActions">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasServices, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource FileButton}" Foreground="{StaticResource Success}" ToolTip="Start its services"
                                AutomationProperties.Name="Start services"
                                Command="{Binding DataContext.StartServicesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <materialDesign:PackIcon Kind="Play" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource FileButton}" Foreground="{StaticResource Danger}" ToolTip="Stop its services"
                                AutomationProperties.Name="Stop services"
                                Command="{Binding DataContext.StopServicesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <materialDesign:PackIcon Kind="Stop" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource FileButton}" Foreground="{StaticResource Brand}" ToolTip="Restart its services"
                                AutomationProperties.Name="Restart services"
                                Command="{Binding DataContext.RestartServicesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <materialDesign:PackIcon Kind="Restart" Width="14" Height="14" />
                        </Button>
                        <Rectangle Width="1" Height="14" Fill="{StaticResource Hairline}" Margin="3,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource FileButton}" Foreground="{StaticResource Brand}"
                            ToolTip="Clone: deploy as a new install that starts from a copy of this one"
                            Command="{Binding DataContext.CloneInstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Target}">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                    </Button>
                    <Button Style="{StaticResource FileButton}" Foreground="{StaticResource Danger}" ToolTip="Remove this install, confirming each step"
                            Command="{Binding DataContext.RemoveInstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding Target}">
                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </DataTemplate>

            <!-- How an install's services are doing: a green dot when they run, red when they're stopped, amber for
                 anything between, and a question mark when no service runs from the install. Hover it for each one. -->
            <DataTemplate x:Key="ServiceDot">
                <TextBlock x:Name="Dot" Text="●" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Background="Transparent"
                           ToolTip="{Binding ServiceTip}" AutomationProperties.Name="{Binding ServiceTip}" Visibility="Collapsed" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding ServiceState}" Value="{x:Static vm:ServiceState.Running}">
                        <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource Success}" />
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ServiceState}" Value="{x:Static vm:ServiceState.Stopped}">
                        <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource Danger}" />
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ServiceState}" Value="{x:Static vm:ServiceState.Mixed}">
                        <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource Warning}" />
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ServiceState}" Value="{x:Static vm:ServiceState.NotFound}">
                        <Setter TargetName="Dot" Property="Text" Value="?" />
                        <Setter TargetName="Dot" Property="FontSize" Value="12" />
                        <Setter TargetName="Dot" Property="FontWeight" Value="Bold" />
                        <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource InkFaint}" />
                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- How the open package's version compares with an install's: up when it's newer, down when it's older.
                 An icon on its own isn't seen by screen readers, so a Label carries what it means. -->
            <DataTemplate x:Key="VersionChange">
                <Label x:Name="Holder" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center" Background="Transparent" Focusable="False"
                       ToolTip="{Binding ChangeTip}" AutomationProperties.Name="{Binding ChangeTip}" Visibility="Collapsed">
                    <materialDesign:PackIcon x:Name="Arrow" Width="14" Height="14" />
                </Label>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Change}" Value="{x:Static core:VersionChange.Upgrade}">
                        <Setter TargetName="Arrow" Property="Kind" Value="ArrowUpBold" />
                        <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Success}" />
                        <Setter TargetName="Holder" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Change}" Value="{x:Static core:VersionChange.Downgrade}">
                        <Setter TargetName="Arrow" Property="Kind" Value="ArrowDownBold" />
                        <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource Warning}" />
                        <Setter TargetName="Holder" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Change}" Value="{x:Static core:VersionChange.Same}">
                        <Setter TargetName="Arrow" Property="Kind" Value="EqualBox" />
                        <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource InkFaint}" />
                        <Setter TargetName="Holder" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A folder: clicking it goes into it. Installs show their version, kind and how their services are doing. -->
            <DataTemplate DataType="{x:Type vm:FolderNodeViewModel}">
                <Button x:Name="Row" Style="{StaticResource FolderRow}" ToolTip="{Binding FullPath}"
                        Command="{Binding DataContext.Folder.GoIntoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon x:Name="Icon" Kind="{Binding Icon}" Width="16" Height="16" Foreground="{StaticResource InkMuted}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="Name" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="Version" Style="{StaticResource Chip}" Margin="8,0,0,0"
                                    Visibility="{Binding Detail.Length, Converter={StaticResource NonZeroToVisible}}">
                                <TextBlock Text="{Binding Detail}" />
                            </Border>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource VersionChange}" />
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ServiceDot}" />
                        </StackPanel>
                        <ContentControl x:Name="Actions" Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource InstallActions}"
                                        Focusable="False" Margin="4,0,0,0" Visibility="Collapsed" />
                        <materialDesign:PackIcon Grid.Column="3" Kind="ChevronRight" Width="16" Height="16" Foreground="{StaticResource InkFaint}"
                                                 VerticalAlignment="Center" Margin="4,0,0,0" />
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsInstall}" Value="True">
                        <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brand}" />
                        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                        <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource InkFaint}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsInstall}" Value="False">
                        <Setter TargetName="Version" Property="Background" Value="{StaticResource Canvas}" />
                        <Setter TargetName="Version" Property="TextElement.Foreground" Value="{StaticResource InkMuted}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                            <Condition Binding="{Binding IsInstall}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- The last row in the install folder: a new install, named in place so the installs already there stay in
                 view. Clicking it or typing a name picks it, and it is tinted while it is the deploy's target. -->
            <DataTemplate DataType="{x:Type vm:NewInstallRowViewModel}">
                <Border x:Name="Row" CornerRadius="4" Height="34" Margin="0,2,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource FileButton}" Foreground="{StaticResource Brand}" Margin="1,0,5,0"
                                Command="{Binding PickCommand}" ToolTip="Deploy as a new install">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" />
                        </Button>
                        <TextBox MinWidth="150" Padding="0,3" Margin="0,0,8,0" VerticalAlignment="Center"
                                 materialDesign:HintAssist.Hint="New install name" AutomationProperties.Name="New install name" materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsTarget}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource BrandTint}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- ===== The steps ===== -->

            <DataTemplate DataType="{x:Type vm:StepViewModel}">
                <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid Margin="{Binding Indent}" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="CircleOutline" />
                                    <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StepState.Running}">
                                            <Setter Property="Kind" Value="PlayCircle" />
                                            <Setter Property="Foreground" Value="{StaticResource Brand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StepState.Succeeded}">
                                            <Setter Property="Kind" Value="CheckCircle" />
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StepState.Skipped}">
                                            <Setter Property="Kind" Value="MinusCircleOutline" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static core:StepState.Failed}">
                                            <Setter Property="Kind" Value="CloseCircle" />
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <materialDesign:PackIcon Grid.Column="1" Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,10,0"
                                                 Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" />
                        <!-- Runs on one line: whitespace between them would show as a leading space. -->
                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"><Run Text="{Binding Branch, Mode=OneWay}" Foreground="{StaticResource Brand}" FontWeight="SemiBold" /><Run Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource Ink}" /></TextBlock>
                        <materialDesign:PackIcon Grid.Column="3" Kind="HelpCircleOutline" Width="16" Height="16" Margin="8,0,0,0"
                                                 Foreground="{StaticResource Brand}" VerticalAlignment="Center" Background="Transparent"
                                                 ToolTip="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- ===== The deploy's reviews, in place of the tabs ===== -->

            <!-- Step 1: the files -->
            <DataTemplate DataType="{x:Type vm:FilesStageViewModel}">
                <DockPanel>
                    <Border Style="{StaticResource PaneHeader}">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PaneToggle}" IsChecked="{Binding ShowUnchanged}"
                                          ToolTip="Show files that are the same on the server">
                                <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" />
                            </ToggleButton>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource FilterBox}" Width="200" Margin="0,0,8,0"
                                     Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Margin" Value="4,0,14,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </StackPanel.Resources>
                                <materialDesign:PackIcon Kind="FilePlusOutline" Foreground="{StaticResource Success}" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="new" />
                                <materialDesign:PackIcon Kind="FileSyncOutline" Foreground="{StaticResource Brand}" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="changed" />
                                <materialDesign:PackIcon Kind="FileCheckOutline" Foreground="{StaticResource InkFaint}" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="same" />
                                <materialDesign:PackIcon Kind="FileQuestionOutline" Foreground="{StaticResource Warning}" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="only on the server" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}" Style="{StaticResource VirtualList}" Padding="0,0,0,8" />
                </DockPanel>
            </DataTemplate>

            <!-- Step 2: the config files, each as a side-by-side diff. The files are chips across the top, so the diff gets the
                 pane's full width. -->
            <DataTemplate DataType="{x:Type vm:ConfigStageViewModel}">
                <DockPanel x:Name="Review" DataContext="{Binding Review}">
                    <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Padding="14,12,8,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ToolTip" Value="{Binding KindTip}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Chip" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,6" Margin="0,0,6,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource Canvas}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource BrandTint}" />
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Brand}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConfigFileViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon x:Name="KindIcon" Kind="FileSyncOutline" Width="16" Height="16"
                                                             Foreground="{StaticResource Brand}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontFamily="{StaticResource Code}" FontSize="12" />
                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" ToolTip="{Binding ConflictText}"
                                                Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="{StaticResource Warning}" Width="14" Height="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ConflictCount}" Foreground="{StaticResource Warning}" FontSize="11" FontWeight="SemiBold"
                                                   Margin="3,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0" ToolTip="Changes to the server's file"
                                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ChangeCount}" />
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigFileKind.New}">
                                        <Setter TargetName="KindIcon" Property="Kind" Value="FilePlusOutline" />
                                        <Setter TargetName="KindIcon" Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigFileKind.Override}">
                                        <Setter TargetName="KindIcon" Property="Kind" Value="LayersOutline" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource PaneHeader}">
                        <DockPanel>
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFile.Folder}"><Run Text="{Binding SelectedFile.KindTip, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SelectedFile.Folder, Mode=OneWay}" Foreground="{StaticResource InkMuted}" FontSize="12" FontFamily="{StaticResource Code}" /></TextBlock>
                        </DockPanel>
                    </Border>
                    <app:ConfigFileView DataContext="{Binding SelectedFile}" IsReadOnly="{Binding DataContext.IsReadOnly, ElementName=Review}" />
                </DockPanel>
            </DataTemplate>

            <!-- A stage of the deploy in the stepper above a review -->
            <Style x:Key="StageDot" TargetType="Border">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="BorderBrush" Value="{StaticResource InkFaint}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource InkMuted}" />
                <Setter Property="TextElement.FontSize" Value="11" />
                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
            <!-- Where the deploy is: 1 Files, 2 Config, 3 Deploy. The review's Number is the current stage. -->
            <DataTemplate x:Key="Stepper">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="FilesDot" Style="{StaticResource StageDot}">
                        <Grid>
                            <TextBlock x:Name="FilesNumber" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <materialDesign:PackIcon x:Name="FilesDone" Kind="Check" Width="13" Height="13" Visibility="Collapsed"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FilesLabel" Text="Files" VerticalAlignment="Center" Foreground="{StaticResource InkMuted}" />
                    <Rectangle Width="36" Height="1" Fill="{StaticResource Hairline}" Margin="12,0" VerticalAlignment="Center" />
                    <Border x:Name="ConfigDot" Style="{StaticResource StageDot}">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ConfigLabel" Text="Config" VerticalAlignment="Center" Foreground="{StaticResource InkMuted}" />
                    <Rectangle Width="36" Height="1" Fill="{StaticResource Hairline}" Margin="12,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource StageDot}">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Deploy" VerticalAlignment="Center" Foreground="{StaticResource InkMuted}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Number}" Value="1">
                        <Setter TargetName="FilesDot" Property="Background" Value="{StaticResource Brand}" />
                        <Setter TargetName="FilesDot" Property="BorderBrush" Value="{StaticResource Brand}" />
                        <Setter TargetName="FilesDot" Property="TextElement.Foreground" Value="White" />
                        <Setter TargetName="FilesLabel" Property="Foreground" Value="{StaticResource Ink}" />
                        <Setter TargetName="FilesLabel" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Number}" Value="2">
                        <Setter TargetName="FilesDot" Property="BorderBrush" Value="{StaticResource Success}" />
                        <Setter TargetName="FilesDot" Property="TextElement.Foreground" Value="{StaticResource Success}" />
                        <Setter TargetName="FilesNumber" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="FilesDone" Property="Visibility" Value="Visible" />
                        <Setter TargetName="ConfigDot" Property="Background" Value="{StaticResource Brand}" />
                        <Setter TargetName="ConfigDot" Property="BorderBrush" Value="{StaticResource Brand}" />
                        <Setter TargetName="ConfigDot" Property="TextElement.Foreground" Value="White" />
                        <Setter TargetName="ConfigLabel" Property="Foreground" Value="{StaticResource Ink}" />
                        <Setter TargetName="ConfigLabel" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- The brand bar: what is open, and the ways to open something -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brand}" Padding="16,0,12,0" Height="48">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BarButton}" Command="{Binding OpenPackageCommand}" Content="Open package"
                            Tag="{x:Static materialDesign:PackIconKind.PackageVariant}" ToolTip="Open a deploy package (.zip)" />
                    <Button Style="{StaticResource BarButton}" Command="{Binding OpenFolderCommand}" Content="Open folder"
                            Tag="{x:Static materialDesign:PackIconKind.FolderOpenOutline}" ToolTip="Manage an install folder without a package" />
                    <Button Style="{StaticResource BarButton}" Command="{Binding OpenConfigCommand}" Content="Open config"
                            Tag="{x:Static materialDesign:PackIconKind.CodeJson}" ToolTip="Open a deploy.json to edit" />
                    <Button Style="{StaticResource BarButton}" Command="{Binding NewConfigCommand}" Content="New config"
                            Tag="{x:Static materialDesign:PackIconKind.FilePlusOutline}" ToolTip="Write a new deploy.json" />
                </StackPanel>
                <materialDesign:PackIcon Kind="RocketLaunch" Width="24" Height="24" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="White" ToolTip="{Binding HeaderDetail}"><Run Text="{Binding HeaderTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" /><Run Text="    " /><Run Text="{Binding HeaderDetail, Mode=OneWay}" FontSize="12" Foreground="#BFFFFFFF" /></TextBlock>
            </DockPanel>
        </Border>

        <ProgressBar DockPanel.Dock="Top" Height="3" Value="{Binding Progress, Mode=OneWay}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="18,6">
            <DockPanel>
                <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource Brand}" Width="15" Height="15"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="{StaticResource InkMuted}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <!-- Nothing open: the ways to start -->
            <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" Margin="16">
                <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Hairline}" StrokeThickness="2" StrokeDashArray="6 4" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <Border Width="80" Height="80" CornerRadius="40" Background="{StaticResource BrandTint}" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="RocketLaunch" Width="40" Height="40" Foreground="{StaticResource Brand}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Drop a package, folder or deploy.json here" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,20,0,6" />
                    <TextBlock Text="Open a package to deploy it, an install folder to manage what is already there, or a deploy.json to edit it."
                               Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenPackageCommand}" Margin="0,0,8,0"
                                Content="Open package" Tag="{x:Static materialDesign:PackIconKind.PackageVariant}" ContentTemplate="{StaticResource IconLabel}" />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0"
                                Content="Open folder" Tag="{x:Static materialDesign:PackIconKind.FolderOpenOutline}" ContentTemplate="{StaticResource IconLabel}" />
                        <Button Style="{StaticResource QuietButton}" Command="{Binding NewConfigCommand}"
                                Content="New config" Tag="{x:Static materialDesign:PackIconKind.FilePlusOutline}" ContentTemplate="{StaticResource IconLabel}" />
                    </StackPanel>

                    <!-- What was opened lately, to open again in one click -->
                    <StackPanel Margin="0,30,0,0" Visibility="{Binding Recent.Count, Converter={StaticResource NonZeroToVisible}}">
                        <TextBlock Text="RECENT" Style="{StaticResource SectionLabel}" Margin="8,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecentItemViewModel}">
                                    <Button Style="{StaticResource FolderRow}" Height="44" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <DockPanel>
                                            <materialDesign:PackIcon Kind="{Binding Icon}" Width="20" Height="20" Foreground="{StaticResource Brand}"
                                                                     VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" FontFamily="{StaticResource Code}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="300" MaxWidth="900" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="480" />
                </Grid.ColumnDefinitions>

                <!-- ===== Left: the package, then the install folder ===== -->
                <DockPanel>
                    <!-- Needs administrator rights -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource WarningTint}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Height="30" Command="{Binding RestartElevatedCommand}"
                                    Content="Restart as admin" Tag="{x:Static materialDesign:PackIconKind.ShieldAccount}" ContentTemplate="{StaticResource IconLabel}" />
                            <materialDesign:PackIcon Kind="ShieldAlertOutline" Foreground="{StaticResource Warning}" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Text="Deploying needs administrator rights. A dry run doesn't." />
                        </DockPanel>
                    </Border>

                    <!-- What was left out of the package's deploy.json or looks off, such as a file from another version -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource WarningTint}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding PackageWarning, Converter={StaticResource NullToCollapsed}}">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="AlertOutline" Foreground="{StaticResource Warning}" Width="18" Height="18"
                                                     VerticalAlignment="Top" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding PackageWarning}" TextWrapping="Wrap" FontSize="12" />
                        </DockPanel>
                    </Border>

                    <!-- The package: its settings and the deploy -->
                    <materialDesign:Card DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="0" Margin="0,0,0,12"
                                         Visibility="{Binding HasPackage, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Border Style="{StaticResource PaneHeader}">
                                <DockPanel>
                                    <materialDesign:PackIcon Kind="PackageVariant" Width="16" Height="16" Foreground="{StaticResource Brand}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="PACKAGE" Style="{StaticResource SectionLabel}" />
                                </DockPanel>
                            </Border>

                            <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                                <!-- While a deploy runs: the step it is on -->
                                <DockPanel Margin="0,0,0,10" Visibility="{Binding RunningStep, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource InkMuted}" Margin="8,0,0,0"
                                               Text="{Binding Progress, StringFormat={}{0:0}%}" />
                                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="Running: " Foreground="{StaticResource InkMuted}" /><Run Text="{Binding RunningStep, Mode=OneWay}" /></TextBlock>
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding DryRunCommand}" Margin="0,0,6,0"
                                            Content="Dry run" Tag="{x:Static materialDesign:PackIconKind.PlayOutline}" ContentTemplate="{StaticResource IconLabel}"
                                            ToolTip="Go through every step without changing anything" />
                                    <!-- Says what happens to the install picked in the folder: Add, Update or Rename -->
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding DeployCommand}" Margin="6,0,0,0"
                                            Content="{Binding Install.DeployLabel, FallbackValue=Deploy}" ContentTemplate="{StaticResource IconLabel}"
                                            Tag="{Binding Install.PlanIcon, FallbackValue={x:Static materialDesign:PackIconKind.CloudUpload}}"
                                            ToolTip="Review the files, then deploy" />
                                </UniformGrid>
                                <!-- Cancel while a deploy runs, Roll back after one: each shows only when it can be used. While a review
                                     is up, its own Cancel is the one to use. -->
                                <UniformGrid Columns="2">
                                    <Button Command="{Binding CancelCommand}" Margin="0,8,6,0" Height="32"
                                            Content="Cancel" Tag="{x:Static materialDesign:PackIconKind.Cancel}" ContentTemplate="{StaticResource IconLabel}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                                                            <Condition Binding="{Binding IsReviewing}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource QuietButton}" Height="32" Command="{Binding RollBackCommand}" Margin="6,8,0,0"
                                            Content="Roll back" Tag="{x:Static materialDesign:PackIconKind.Restore}" ContentTemplate="{StaticResource IconLabel}"
                                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}" />
                                </UniformGrid>
                            </StackPanel>

                            <!-- MaterialDesign's scroll viewer ignores Padding, so the space is a margin on the list. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                <ItemsControl ItemsSource="{Binding Parameters}" Focusable="False" IsEnabled="{Binding IsIdle}" Margin="14,14,14,2" />
                            </ScrollViewer>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- A config open on its own: nothing to deploy yet -->
                    <materialDesign:Card DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="16"
                                         Visibility="{Binding IsConfigOnly, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="No package open" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="Save this config as deploy.json next to your app's files. Its folder then opens here as the package, ready for a dry run."
                                       Style="{StaticResource Caption}" Margin="0,6,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Height="32" Command="{Binding OpenPackageCommand}" Margin="0,0,8,0"
                                        Content="Open package" Tag="{x:Static materialDesign:PackIconKind.PackageVariant}" ContentTemplate="{StaticResource IconLabel}" />
                                <Button Style="{StaticResource QuietButton}" Height="32" Command="{Binding OpenFolderCommand}"
                                        Content="Open folder" Tag="{x:Static materialDesign:PackIconKind.FolderOpenOutline}" ContentTemplate="{StaticResource IconLabel}" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- The install folder: where the deploy goes, and what is there now -->
                    <materialDesign:Card Style="{StaticResource Panel}" Padding="0" IsEnabled="{Binding IsIdle}"
                                         Visibility="{Binding IsConfigOnly, Converter={StaticResource InverseBoolToVisibility}}">
                        <DockPanel>
                            <Border Style="{StaticResource PaneHeader}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PaneButton}" Command="{Binding Folder.ReloadCommand}"
                                            ToolTip="Refresh" Visibility="{Binding HasFolder, Converter={StaticResource BoolToVisibility}}">
                                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                                    </Button>
                                    <materialDesign:PackIcon Kind="FolderCogOutline" Width="16" Height="16" Foreground="{StaticResource Brand}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="INSTALL FOLDER" Style="{StaticResource SectionLabel}" />
                                </DockPanel>
                            </Border>

                            <!-- The folder: typed for a package, fixed for a folder opened on its own -->
                            <StackPanel DockPanel.Dock="Top" Margin="14,14,14,10">
                                <ContentControl Content="{Binding FolderField}" ContentTemplate="{StaticResource PathInput}" Focusable="False"
                                                Visibility="{Binding FolderField, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock Text="{Binding Folder.Root}" FontFamily="{StaticResource Code}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource InkMuted}" ToolTip="{Binding Folder.Root}"
                                           Visibility="{Binding FolderField, Converter={StaticResource NullToVisible}}" />
                                <TextBlock Text="{Binding FolderNote}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Visibility="{Binding FolderNote, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>

                            <!-- Exactly what the deploy will do to the installs, or what it still needs -->
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                                    Padding="14,12,14,14" DataContext="{Binding Install}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                                <StackPanel>
                                    <DockPanel Visibility="{Binding Problem, Converter={StaticResource NullToVisible}}">
                                        <materialDesign:PackIcon Kind="{Binding PlanIcon}" Foreground="{StaticResource Brand}" Width="18" Height="18" Margin="0,0,10,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- A new install without a name yet is a prompt; anything else is a problem to fix -->
                                    <DockPanel Visibility="{Binding Problem, Converter={StaticResource NullToCollapsed}}">
                                        <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,10,0">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="AlertCircleOutline" />
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsName}" Value="True">
                                                            <Setter Property="Kind" Value="PencilOutline" />
                                                            <Setter Property="Foreground" Value="{StaticResource Brand}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsName}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                    <HeaderedContentControl Style="{StaticResource Field}" Header="Install name" Margin="0,12,0,0"
                                                            Visibility="{Binding CanRename, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox Style="{StaticResource InputBox}" Background="{StaticResource Surface}" AutomationProperties.Name="Install name"
                                                 ToolTip="Change it to move this install to a new folder"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Style="{StaticResource Field}" Header="Start from" Margin="0,12,0,0"
                                                            Visibility="{Binding CanCopy, Converter={StaticResource BoolToVisibility}}">
                                        <ComboBox Style="{StaticResource InputChoice}" Background="{StaticResource Surface}" AutomationProperties.Name="Start from"
                                                  ItemsSource="{Binding CopySources}" SelectedItem="{Binding CopyFrom}" DisplayMemberPath="CopyLabel" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <!-- The folders, one level at a time: click one to go into it and list its files on the right, Up to come
                                 back. Going into an install makes it the deploy's target. -->
                            <DockPanel Visibility="{Binding HasFolder, Converter={StaticResource BoolToVisibility}}">
                                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1" Background="{StaticResource Canvas}"
                                        Padding="6,3,8,3" DataContext="{Binding Folder}">
                                    <Grid x:Name="Here" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource PaneButton}" Command="{Binding GoUpCommand}" ToolTip="Up one folder">
                                            <materialDesign:PackIcon Kind="ArrowUp" Width="16" Height="16" />
                                        </Button>
                                        <materialDesign:PackIcon Grid.Column="1" Kind="{Binding CurrentFolder.Icon}" Width="16" Height="16" Foreground="{StaticResource Brand}"
                                                                 VerticalAlignment="Center" Margin="4,0,8,0" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" ToolTip="{Binding CurrentFolder.FullPath}">
                                            <TextBlock Text="{Binding Location}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0"
                                                    Visibility="{Binding CurrentFolder.Detail.Length, Converter={StaticResource NonZeroToVisible}, FallbackValue=Collapsed}">
                                                <TextBlock Text="{Binding CurrentFolder.Detail}" />
                                            </Border>
                                            <ContentPresenter Content="{Binding CurrentFolder}" ContentTemplate="{StaticResource VersionChange}" />
                                            <ContentPresenter Content="{Binding CurrentFolder}" ContentTemplate="{StaticResource ServiceDot}" />
                                        </StackPanel>
                                        <ContentControl Grid.Column="3" Content="{Binding CurrentFolder}" ContentTemplate="{StaticResource InstallActions}" Focusable="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsMouseOver, ElementName=Here}" Value="True" />
                                                                <Condition Binding="{Binding CurrentFolder.IsInstall}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </Grid>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="8,6,8,8">
                                        <ItemsControl ItemsSource="{Binding Folder.Rows}" Focusable="False" />
                                        <TextBlock Text="No folders in here." Style="{StaticResource Caption}" Margin="8,6,0,0"
                                                   Visibility="{Binding Folder.Rows.Count, Converter={StaticResource ZeroToVisible}}" />

                                        <!-- Backups a deploy made of this folder, to put one back -->
                                        <StackPanel Margin="0,14,0,0" Visibility="{Binding Folder.HasBackups, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                            <StackPanel Orientation="Horizontal" Margin="6,0,0,4">
                                                <materialDesign:PackIcon Kind="ArchiveOutline" Width="14" Height="14" Foreground="{StaticResource Brand}"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="BACKUPS" Style="{StaticResource SectionLabel}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Folder.Backups}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:BackupViewModel}">
                                                        <DockPanel Height="30" Margin="6,0,0,0" ToolTip="{Binding Path}">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Height="26" Padding="8,0"
                                                                    Content="Restore" Tag="{x:Static materialDesign:PackIconKind.Restore}" ContentTemplate="{StaticResource IconLabel}"
                                                                    ToolTip="Put this backup back in place of the folder's files"
                                                                    Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <materialDesign:PackIcon Kind="History" Width="14" Height="14" Foreground="{StaticResource InkMuted}"
                                                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- The deploys made to this folder from this machine, newest first -->
                                        <StackPanel Margin="0,14,0,0" Visibility="{Binding Folder.HasHistory, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                            <StackPanel Orientation="Horizontal" Margin="6,0,0,4">
                                                <materialDesign:PackIcon Kind="ClipboardTextClockOutline" Width="14" Height="14" Foreground="{StaticResource Brand}"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="HISTORY" Style="{StaticResource SectionLabel}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Folder.History}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HistoryEntryViewModel}">
                                                        <DockPanel Margin="6,2,0,2" ToolTip="{Binding Record.Log}">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Height="26" Padding="8,0"
                                                                    Content="Log" Tag="{x:Static materialDesign:PackIconKind.TextBoxOutline}" ContentTemplate="{StaticResource IconLabel}"
                                                                    ToolTip="Open this deploy's log" Command="{Binding OpenLogCommand}"
                                                                    Visibility="{Binding HasLog, Converter={StaticResource BoolToVisibility}}" />
                                                            <materialDesign:PackIcon x:Name="ResultIcon" Kind="{Binding Icon}" Width="14" Height="14" Foreground="{StaticResource Success}"
                                                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Static core:DeployResult.Failed}">
                                                                <Setter TargetName="ResultIcon" Property="Foreground" Value="{StaticResource Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Result}" Value="{x:Static core:DeployResult.Cancelled}">
                                                                <Setter TargetName="ResultIcon" Property="Foreground" Value="{StaticResource Warning}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </DockPanel>
                    </materialDesign:Card>
                </DockPanel>

                <GridSplitter Grid.Column="1" Style="{StaticResource GapSplitter}" />

                <!-- ===== Right: the tabs, or the review a deploy is waiting on ===== -->
                <materialDesign:Card Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
                    <Grid>
                        <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}" HorizontalContentAlignment="Left" Padding="0"
                                    materialDesign:ColorZoneAssist.Mode="Standard"
                                    Visibility="{Binding IsReviewing, Converter={StaticResource InverseBoolToVisibility}}">
                            <!-- Files: the folder picked in the tree, with the settings editor beside it -->
                            <TabItem Header="Files" Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}" HeaderTemplate="{StaticResource TabHeader}"
                                     Visibility="{Binding HasFolder, Converter={StaticResource BoolToVisibility}}">
                                <Grid DataContext="{Binding Folder}">
                                    <!-- The files, a splitter, and the settings file being edited. With no file open, the list takes
                                         the whole width; the columns keep the widths dragged to for the next file. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" MinWidth="320" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel>
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasOpenFile}" Value="True">
                                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <Border Style="{StaticResource PaneHeader}">
                                            <DockPanel>
                                                <ProgressBar DockPanel.Dock="Right" Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                                                             Width="16" Height="16" Margin="8,0" Visibility="{Binding IsListing, Converter={StaticResource BoolToVisibility}}" />
                                                <materialDesign:PackIcon Kind="{Binding CurrentFolder.Icon}" Width="16" Height="16" Foreground="{StaticResource Brand}"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <StackPanel Orientation="Horizontal" ToolTip="{Binding CurrentFolder.FullPath}">
                                                    <TextBlock Text="{Binding Location}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Style="{StaticResource Chip}" Margin="8,0,0,0"
                                                            Visibility="{Binding CurrentFolder.IsInstall, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                                        <TextBlock Text="install" />
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <Border DockPanel.Dock="Top" Padding="10,8,10,4">
                                            <TextBox Style="{StaticResource FilterBox}" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                        </Border>

                                        <!-- Why the file last picked didn't open, such as it not being text -->
                                        <DockPanel DockPanel.Dock="Top" Margin="14,2,10,4"
                                                   Visibility="{Binding OpenError, Converter={StaticResource NullToCollapsed}}">
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{StaticResource Warning}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding OpenError}" FontSize="12" Foreground="{StaticResource Warning}" TextWrapping="Wrap" />
                                        </DockPanel>

                                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="14,6"
                                                   Visibility="{Binding IsCapped, Converter={StaticResource BoolToVisibility}}"
                                                   Text="Showing the first 5,000 files. Go into a subfolder on the left to see the rest." />

                                        <Grid>
                                            <ItemsControl ItemsSource="{Binding Items}" Style="{StaticResource VirtualList}" Padding="0,2,0,8" />
                                            <TextBlock Text="{Binding NoFilesText}" Style="{StaticResource Caption}" Margin="44,16"
                                                       Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                    </DockPanel>

                                    <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"
                                                  Visibility="{Binding HasOpenFile, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- The file being edited, with its changes tracked -->
                                    <DockPanel Grid.Column="2" Visibility="{Binding HasOpenFile, Converter={StaticResource BoolToVisibility}}">
                                        <Border Style="{StaticResource PaneHeader}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource PaneButton}" Command="{Binding CloseFileCommand}" ToolTip="Close">
                                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                                </Button>
                                                <materialDesign:PackIcon Kind="FileEditOutline" Width="16" Height="16" Foreground="{StaticResource Brand}"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OpenFile.Folder}"><Run Text="{Binding OpenFile.FileName, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource Code}" /><Run Text="   " /><Run Text="{Binding OpenFile.Folder, Mode=OneWay}" Foreground="{StaticResource InkMuted}" FontSize="12" /></TextBlock>
                                            </DockPanel>
                                        </Border>
                                        <app:ConfigFileView DataContext="{Binding OpenFile}" />
                                    </DockPanel>

                                    <!-- Staged changes, written together. The bar spans both panes, so its text has room. -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource BrandTint}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="14,8,12,8"
                                            Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource QuietButton}" Height="32" Command="{Binding DiscardCommand}" Margin="0,0,6,0"
                                                        Content="Discard" Tag="{x:Static materialDesign:PackIconKind.Undo}" ContentTemplate="{StaticResource IconLabel}" />
                                                <Button Style="{StaticResource PrimaryButton}" Height="32"
                                                        Command="{Binding DataContext.FinalizeFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Content="Finalize" Tag="{x:Static materialDesign:PackIconKind.ContentSaveCheckOutline}" ContentTemplate="{StaticResource IconLabel}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding PendingText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brand}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Steps" Tag="{x:Static materialDesign:PackIconKind.FormatListChecks}" HeaderTemplate="{StaticResource TabHeader}"
                                     Visibility="{Binding HasPackage, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Steps}" Style="{StaticResource VirtualList}" Padding="0,0,0,8" />
                            </TabItem>

                            <!-- deploy.json: the visual editor -->
                            <TabItem Header="deploy.json" Tag="{x:Static materialDesign:PackIconKind.CodeJson}" HeaderTemplate="{StaticResource TabHeader}"
                                     Visibility="{Binding HasEditor, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Border Style="{StaticResource PaneHeader}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource QuietButton}" Height="30" Command="{Binding SaveConfigCommand}"
                                                        Content="Save" Tag="{x:Static materialDesign:PackIconKind.ContentSaveOutline}" ContentTemplate="{StaticResource IconLabel}" />
                                                <Button Style="{StaticResource QuietButton}" Height="30" Command="{Binding SaveConfigAsCommand}"
                                                        Content="Save as" Tag="{x:Static materialDesign:PackIconKind.ContentSaveEditOutline}" ContentTemplate="{StaticResource IconLabel}" />
                                            </StackPanel>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Editor.FilePath}"><Run Text="{Binding Editor.Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Editor.FilePath, Mode=OneWay}" Foreground="{StaticResource InkMuted}" FontSize="12" FontFamily="{StaticResource Code}" /></TextBlock>
                                        </DockPanel>
                                    </Border>
                                    <app:EditorView x:Name="Editor" DataContext="{Binding Editor}" />
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Log" Tag="{x:Static materialDesign:PackIconKind.ConsoleLine}" HeaderTemplate="{StaticResource TabHeader}">
                                <DockPanel>
                                    <!-- After a dry run: what the deploy would change, so the log needn't be read for it -->
                                    <Border DockPanel.Dock="Top" DataContext="{Binding Summary}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}"
                                            Background="{StaticResource BrandTint}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="16,10,8,12">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PaneButton}" VerticalAlignment="Top" ToolTip="Close the summary"
                                                    Command="{Binding DataContext.CloseSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                            </Button>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SummaryLine}">
                                                            <DockPanel Margin="0,2">
                                                                <materialDesign:PackIcon Kind="{Binding Icon}" Width="15" Height="15" Foreground="{StaticResource Brand}"
                                                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                <Grid>
                                    <ListBox x:Name="LogList" Style="{StaticResource LogList}" />
                                    <TextBlock Text="Dry runs, deploys and tools you run from the folder are logged here." Style="{StaticResource Caption}"
                                               Margin="20,16" Visibility="{Binding Log.Count, Converter={StaticResource ZeroToVisible}}" />
                                </Grid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>

                        <!-- A review the deploy is waiting on: a stepper, the review, and Continue -->
                        <DockPanel DataContext="{Binding Stage}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
                            <Border DockPanel.Dock="Top" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="16,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{StaticResource Warning}"
                                                Visibility="{Binding IsDryRun, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Dry run: nothing will change" />
                                        </Border>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Stepper}" Focusable="False" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" Margin="0,12,0,2" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>

                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="16,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource QuietButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                            Content="Cancel" Tag="{x:Static materialDesign:PackIconKind.Cancel}" ContentTemplate="{StaticResource IconLabel}" />
                                    <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" Command="{Binding ContinueCommand}"
                                            Content="{Binding ContinueText}" Tag="{x:Static materialDesign:PackIconKind.ArrowRight}" ContentTemplate="{StaticResource IconLabel}" />
                                </StackPanel>
                            </Border>

                            <ContentControl Content="{Binding}" Focusable="False" />
                        </DockPanel>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

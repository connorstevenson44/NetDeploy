<Window x:Class="NetDeploy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:NetDeploy.Core;assembly=NetDeploy.Core"
        Title="NetDeploy" Height="760" Width="1180" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        Closing="OnClosing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12" Background="#F5F6F8" BorderBrush="#DADCE0" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Open package..." Command="{Binding OpenPackageCommand}" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PackagePath}" Foreground="#5F6368" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="16,8" Background="#FFF4CE"
                Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart as administrator" Command="{Binding RestartElevatedCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="This package needs administrator rights to deploy. A dry run works without them." />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,6" Background="#F5F6F8" BorderBrush="#DADCE0" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dry run" Command="{Binding DryRunCommand}" Margin="0,0,8,0" />
                        <Button Content="Deploy" Command="{Binding DeployCommand}" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <Button Content="Roll back last deploy" Command="{Binding RollBackCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Parameters" Style="{StaticResource SectionHeading}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Parameters}" IsEnabled="{Binding IsIdle}" Focusable="False" />
                </ScrollViewer>
            </DockPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="120" />
                </Grid.RowDefinitions>

                <TextBlock Text="Steps" Style="{StaticResource SectionHeading}" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Steps}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{Binding Indent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9AA0A6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:StepState.Running}">
                                                    <Setter Property="Foreground" Value="#1A73E8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:StepState.Succeeded}">
                                                    <Setter Property="Foreground" Value="#188038" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static core:StepState.Failed}">
                                                    <Setter Property="Foreground" Value="#C5221F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Branch, Mode=OneWay}" Foreground="#5F6368" />
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" Foreground="#5F6368" FontSize="11" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="Transparent" />

                <TextBlock Grid.Row="3" Text="Log" Style="{StaticResource SectionHeading}" />
                <ListBox Grid.Row="4" x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="12"
                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Time, Mode=OneWay, StringFormat=HH:mm:ss}" Foreground="#9AA0A6" />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogLevel.Warning}">
                                                <Setter Property="Foreground" Value="#B06000" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static core:LogLevel.Error}">
                                                <Setter Property="Foreground" Value="#C5221F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

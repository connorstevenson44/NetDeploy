<UserControl x:Class="NetDeploy.App.ConfigFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:NetDeploy.App.ViewModels">
    <!-- The side-by-side settings editor: the value now on the left, the value to write on the right.
         DataContext is a ConfigFileViewModel; set IsReadOnly to show it without editing. -->
    <UserControl.Resources>
        <!-- GitHub's diff colours, so changes read the way they do in a pull request. -->
        <SolidColorBrush x:Key="AddedRow" Color="#E6FFEC" />
        <SolidColorBrush x:Key="RemovedRow" Color="#FFEBE9" />
        <SolidColorBrush x:Key="NeedsValueRow" Color="#FFF8C5" />
        <FontFamily x:Key="Code">Cascadia Mono, Consolas</FontFamily>

        <!-- The same six columns for the heading, sections and settings, so everything lines up. -->
        <Style x:Key="Columns" TargetType="Grid">
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <DataTemplate DataType="{x:Type vm:SectionViewModel}">
            <Grid Height="26" Background="{StaticResource Canvas}">
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                    <materialDesign:PackIcon Kind="CodeBraces" Width="14" Height="14" Foreground="{StaticResource InkFaint}"
                                             VerticalAlignment="Center" Margin="{Binding Indent}" />
                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Code}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingViewModel}">
            <Border x:Name="Row" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Background="Transparent">
                <Grid Style="{StaticResource Columns}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon x:Name="Icon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Background="Transparent" ToolTip="{Binding StatusTip}" Visibility="Hidden" />

                    <TextBlock Grid.Column="1" Text="{Binding Key}" Margin="{Binding Indent}" ToolTip="{Binding Path}"
                               FontFamily="{StaticResource Code}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <TextBlock x:Name="Now" Grid.Column="2" Text="{Binding Now}" ToolTip="{Binding Now}" Margin="0,0,6,0"
                               FontFamily="{StaticResource Code}" FontSize="12" Foreground="{StaticResource InkMuted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <!-- Copy the value on the left to the right -->
                    <Button x:Name="KeepNow" Grid.Column="3" Style="{StaticResource RowButton}" Command="{Binding KeepNowCommand}"
                            ToolTip="Keep the value that is there now" Visibility="{Binding CanKeepNow, Converter={StaticResource BoolToVisibility}}">
                        <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="16" Height="16" />
                    </Button>

                    <TextBox x:Name="Value" Grid.Column="4" Text="{Binding Value}" FontFamily="{StaticResource Code}" FontSize="12"
                             VerticalAlignment="Center" Padding="4,2" BorderThickness="0,0,0,1"
                             IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock x:Name="Removed" Grid.Column="4" Text="removed" FontSize="12" FontStyle="Italic" Foreground="{StaticResource Danger}"
                               VerticalAlignment="Center" Margin="4,0" Visibility="Collapsed" />

                    <StackPanel x:Name="Actions" Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource RowButton}" Command="{Binding ResetCommand}"
                                ToolTip="{Binding DataContext.ResetTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding CanReset, Converter={StaticResource BoolToVisibility}}">
                            <materialDesign:PackIcon Kind="Undo" Width="16" Height="16" />
                        </Button>
                        <Button x:Name="RemoveButton" Style="{StaticResource RowButton}" Command="{Binding RemoveCommand}" ToolTip="Remove this setting"
                                Visibility="Hidden">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- The remove button shows on hover, so quiet rows stay quiet. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                        <Condition Binding="{Binding CanRemove}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="KeepNow" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                    <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Removed" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Added}">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AddedRow}" />
                    <Setter TargetName="Icon" Property="Kind" Value="PlusCircle" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Success}" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Removed}">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource RemovedRow}" />
                    <Setter TargetName="Now" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="Icon" Property="Kind" Value="MinusCircle" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Danger}" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Changed}">
                    <Setter TargetName="Icon" Property="Kind" Value="SyncCircle" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brand}" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Kept}">
                    <Setter TargetName="Icon" Property="Kind" Value="Lock" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource InkMuted}" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Edited}">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource BrandTint}" />
                    <Setter TargetName="Icon" Property="Kind" Value="Pencil" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brand}" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.NeedsValue}">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource NeedsValueRow}" />
                    <Setter TargetName="Icon" Property="Kind" Value="AlertCircle" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Warning}" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Value" Property="materialDesign:HintAssist.Hint" Value="{Binding Default}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- What each icon means -->
        <WrapPanel DockPanel.Dock="Top" Margin="16,10,16,6" TextElement.FontSize="11" TextElement.Foreground="{StaticResource InkMuted}">
            <WrapPanel.Resources>
                <Style TargetType="materialDesign:PackIcon">
                    <Setter Property="Width" Value="14" />
                    <Setter Property="Height" Value="14" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,14,0" />
                </Style>
            </WrapPanel.Resources>
            <materialDesign:PackIcon Kind="AlertCircle" Foreground="{StaticResource Warning}" /><TextBlock Text="needs you" />
            <materialDesign:PackIcon Kind="PlusCircle" Foreground="{StaticResource Success}" /><TextBlock Text="new" />
            <materialDesign:PackIcon Kind="SyncCircle" Foreground="{StaticResource Brand}" /><TextBlock Text="changed" />
            <materialDesign:PackIcon Kind="MinusCircle" Foreground="{StaticResource Danger}" /><TextBlock Text="removed" />
            <materialDesign:PackIcon Kind="Lock" Foreground="{StaticResource InkMuted}" /><TextBlock Text="kept" />
            <materialDesign:PackIcon Kind="Pencil" Foreground="{StaticResource Brand}" /><TextBlock Text="your value" />
        </WrapPanel>

        <!-- Column headings -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,1" Background="{StaticResource Surface}">
            <Grid Height="28" Margin="0,0,10,0" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource InkMuted}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="58" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="SETTING" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding NowHeading}" VerticalAlignment="Center" />
                <materialDesign:PackIcon Grid.Column="3" Kind="ArrowRightBold" Width="14" Height="14" Foreground="{StaticResource InkFaint}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding ValueHeading}" VerticalAlignment="Center" Margin="4,0,0,0" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
                <TextBlock Text="Nothing changes in this file." Style="{StaticResource Caption}" Margin="28,16"
                           Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisible}}" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>

<UserControl x:Class="NetDeploy.App.ConfigFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:NetDeploy.App.ViewModels">
    <!-- A side-by-side diff of one config file, like Visual Studio's: the file now on the left, the file after the
         change on the right, with line numbers and the real JSON or XML lines. Values are edited in place on the right,
         or the whole file as text. The two sides are separate lists with a splitter between them: they scroll up and
         down together, and each scrolls sideways on its own when its lines are too long.
         DataContext is a ConfigFileViewModel; set IsReadOnly to show it without editing. -->
    <UserControl.Resources>
        <FontFamily x:Key="Code">Cascadia Mono, Consolas</FontFamily>

        <!-- Every line is the same height on both sides, so the two lists stay level as they scroll. -->
        <Style x:Key="DiffRow" TargetType="Grid">
            <Setter Property="Height" Value="24" />
        </Style>

        <Style x:Key="LineNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Code}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="LineText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Code}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <!-- One side's lines. Its scroll viewer is named, so the view can keep the two sides level. -->
        <Style x:Key="DiffLines" TargetType="ItemsControl" BasedOn="{StaticResource VirtualList}">
            <Setter Property="ItemsSource" Value="{Binding Items}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroll" Focusable="False" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="Hidden">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The heading over each side -->
        <Style x:Key="SideHeading" TargetType="Border">
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="{StaticResource Canvas}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="0,1" />
            <Setter Property="TextElement.FontSize" Value="11" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource InkMuted}" />
        </Style>

        <!-- The whole file as text -->
        <Style x:Key="FileText" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="FontFamily" Value="{StaticResource Code}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed" />
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Totals, like the +/- counts of a diff, and the switch between the diff and the text -->
        <DockPanel DockPanel.Dock="Top" Margin="12,4,8,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="EditAsTextButton" Command="{Binding EditAsTextCommand}" Height="30" Padding="10,0"
                        Tag="{x:Static materialDesign:PackIconKind.CodeBraces}" ContentTemplate="{StaticResource IconLabel}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                            <Setter Property="Content" Value="Edit as text" />
                            <Setter Property="ToolTip" Value="Edit the whole file, for arrays, new sections or anything else, then see what it changes" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTextMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Content" Value="View as text" />
                                    <Setter Property="ToolTip" Value="Show the whole file as it would be written" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsTextMode, Converter={StaticResource BoolToVisibility}}">
                    <Button Command="{Binding DropTextCommand}" Height="30" Padding="10,0" Margin="0,0,4,0" Content="Drop text changes"
                            Tag="{x:Static materialDesign:PackIconKind.Undo}" ContentTemplate="{StaticResource IconLabel}"
                            ToolTip="Put the settings back as they were before you edited the text">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ShowDiffCommand}" Height="30" Padding="10,0" Content="Show changes"
                            Tag="{x:Static materialDesign:PackIconKind.CompareHorizontal}" ContentTemplate="{StaticResource IconLabel}"
                            ToolTip="Back to the side-by-side diff, which shows what your text changes" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Code}" TextElement.FontSize="12">
                <TextBlock Foreground="{StaticResource Success}" Margin="0,0,14,0" ToolTip="Settings added"><Run Text="+" /><Run Text="{Binding AddedCount, Mode=OneWay}" /></TextBlock>
                <TextBlock Foreground="{StaticResource Danger}" Margin="0,0,14,0" ToolTip="Settings removed"><Run Text="−" /><Run Text="{Binding RemovedCount, Mode=OneWay}" /></TextBlock>
                <TextBlock Foreground="{StaticResource Brand}" Margin="0,0,14,0" ToolTip="Settings changed"><Run Text="~" /><Run Text="{Binding ModifiedCount, Mode=OneWay}" /></TextBlock>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="{StaticResource Warning}" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConflictText}" Foreground="{StaticResource Warning}" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Why the text can't be used yet -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource DangerTint}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="12,6"
                Visibility="{Binding HasTextError, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{StaticResource Danger}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock x:Name="TextError" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Danger}" VerticalAlignment="Center"><Run Text="The text can't be read, so the last text that could is used: " /><Run Text="{Binding TextError, Mode=OneWay}" /></TextBlock>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="180" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Headings over the two sides -->
            <Border Style="{StaticResource SideHeading}">
                <TextBlock Text="{Binding NowHeading}" VerticalAlignment="Center" Margin="44,0,0,0" TextTrimming="CharacterEllipsis" />
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SideHeading}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowRight" Width="14" Height="14" Foreground="{StaticResource InkFaint}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ValueHeading}" VerticalAlignment="Center" Margin="51,0,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== The diff, left: the file now ===== -->
            <ItemsControl x:Name="LeftLines" Grid.Row="1" Style="{StaticResource DiffLines}" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.ScrollChanged="OnLinesScrolled"
                          Visibility="{Binding IsTextMode, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl.Resources>
                    <!-- A section's opening or closing line -->
                    <DataTemplate DataType="{x:Type vm:SectionLine}">
                        <Grid Style="{StaticResource DiffRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Side" Grid.ColumnSpan="2" />
                            <TextBlock Text="{Binding LeftNumber}" Style="{StaticResource LineNumber}" />
                            <TextBlock x:Name="Line" Grid.Column="1" Style="{StaticResource LineText}" Margin="{Binding Indent}"><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding LeftSeparator, Mode=OneWay}" /></TextBlock>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOnLeft}" Value="False">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffFiller}" />
                                <Setter TargetName="Line" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOnRight}" Value="False">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffRemoved}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <!-- Unchanged lines folded away -->
                    <DataTemplate DataType="{x:Type vm:GapLine}">
                        <Border Height="24" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1">
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                <materialDesign:PackIcon Kind="UnfoldMoreHorizontal" Width="14" Height="14" Foreground="{StaticResource InkFaint}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>

                    <!-- A setting's line now -->
                    <DataTemplate DataType="{x:Type vm:SettingViewModel}">
                        <Grid Style="{StaticResource DiffRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Side" Grid.ColumnSpan="2" />
                            <Border x:Name="Gutter" />
                            <TextBlock Text="{Binding LeftNumber}" Style="{StaticResource LineNumber}" />
                            <TextBlock x:Name="Now" Grid.Column="1" Style="{StaticResource LineText}" Margin="{Binding Indent}" ToolTip="{Binding NowLine}"><Run Text="{Binding NowLine, Mode=OneWay}" /><Run Text="{Binding LeftSeparator, Mode=OneWay}" /></TextBlock>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOnLeft}" Value="False">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffFiller}" />
                                <Setter TargetName="Now" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Removed}">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffRemoved}" />
                                <Setter TargetName="Gutter" Property="Background" Value="{StaticResource DiffRemovedGutter}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Changed}">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffRemoved}" />
                                <Setter TargetName="Gutter" Property="Background" Value="{StaticResource DiffRemovedGutter}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Edited}" />
                                    <Condition Binding="{Binding IsOnLeft}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffRemoved}" />
                                <Setter TargetName="Gutter" Property="Background" Value="{StaticResource DiffRemovedGutter}" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>

            <GridSplitter Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource PaneSplitter}" />

            <!-- ===== The diff, right: the file after the change, with the values editable ===== -->
            <ItemsControl x:Name="RightLines" Grid.Row="1" Grid.Column="2" Style="{StaticResource DiffLines}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.ScrollChanged="OnLinesScrolled"
                          Visibility="{Binding IsTextMode, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl.Resources>
                    <!-- The same columns on every line: the keep button, status, number, text and actions. -->
                    <DataTemplate DataType="{x:Type vm:SectionLine}">
                        <Grid Style="{StaticResource DiffRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Side" Grid.Column="1" Grid.ColumnSpan="4" />
                            <TextBlock Grid.Column="2" Text="{Binding RightNumber}" Style="{StaticResource LineNumber}" />
                            <TextBlock x:Name="Line" Grid.Column="3" Style="{StaticResource LineText}" Margin="{Binding Indent}"><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding RightSeparator, Mode=OneWay}" /></TextBlock>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOnRight}" Value="False">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffFiller}" />
                                <Setter TargetName="Line" Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOnLeft}" Value="False">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffAdded}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:GapLine}">
                        <Border Height="24" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1" />
                    </DataTemplate>

                    <!-- A setting's line after the change, with the value editable in place -->
                    <DataTemplate DataType="{x:Type vm:SettingViewModel}">
                        <Grid x:Name="Row" Style="{StaticResource DiffRow}" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Side" Grid.Column="1" Grid.ColumnSpan="4" />
                            <Border x:Name="Gutter" Grid.Column="2" />

                            <!-- Copy the line on the left to the right -->
                            <Button x:Name="KeepNow" Style="{StaticResource RowButton}" Command="{Binding KeepNowCommand}"
                                    ToolTip="Keep the value that is there now" Visibility="{Binding CanKeepNow, Converter={StaticResource BoolToVisibility}}">
                                <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="16" Height="16" />
                            </Button>

                            <materialDesign:PackIcon x:Name="Icon" Grid.Column="1" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Background="Transparent" ToolTip="{Binding StatusTip}" Visibility="Hidden" />
                            <TextBlock Grid.Column="2" Text="{Binding RightNumber}" Style="{StaticResource LineNumber}" />

                            <Grid x:Name="After" Grid.Column="3" Margin="{Binding Indent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Before}" Style="{StaticResource LineText}" Margin="0" />
                                <TextBox x:Name="Value" Grid.Column="1" Text="{Binding Value}" ToolTip="{Binding Value}" AutomationProperties.Name="{Binding Path}" FontFamily="{StaticResource Code}" FontSize="12"
                                         MinWidth="48" VerticalAlignment="Center" Padding="2,0" BorderThickness="0,0,0,1"
                                         materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource Brand}"
                                         IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource LineText}"><Run Text="{Binding After, Mode=OneWay}" /><Run Text="{Binding RightSeparator, Mode=OneWay}" /></TextBlock>
                            </Grid>

                            <StackPanel x:Name="Actions" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                <Button Style="{StaticResource RowButton}" Command="{Binding ResetCommand}"
                                        ToolTip="{Binding DataContext.ResetTip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding CanReset, Converter={StaticResource BoolToVisibility}}">
                                    <materialDesign:PackIcon Kind="Undo" Width="15" Height="15" />
                                </Button>
                                <Button x:Name="RemoveButton" Style="{StaticResource RowButton}" Command="{Binding RemoveCommand}" ToolTip="Remove this setting"
                                        Visibility="Hidden">
                                    <materialDesign:PackIcon Kind="Close" Width="15" Height="15" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- The remove button shows on hover, so quiet lines stay quiet. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                    <Condition Binding="{Binding CanRemove}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="KeepNow" Property="Visibility" Value="Hidden" />
                            </DataTrigger>

                            <!-- A side the line isn't on is hatched, as in a diff -->
                            <DataTrigger Binding="{Binding IsOnRight}" Value="False">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffFiller}" />
                                <Setter TargetName="After" Property="Visibility" Value="Hidden" />
                            </DataTrigger>

                            <!-- Green where a line arrives or changes -->
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Added}">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffAdded}" />
                                <Setter TargetName="Gutter" Property="Background" Value="{StaticResource DiffAddedGutter}" />
                                <Setter TargetName="Icon" Property="Kind" Value="Plus" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Success}" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Removed}">
                                <Setter TargetName="Icon" Property="Kind" Value="Minus" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Danger}" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Changed}">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffAdded}" />
                                <Setter TargetName="Gutter" Property="Background" Value="{StaticResource DiffAddedGutter}" />
                                <Setter TargetName="Icon" Property="Kind" Value="SwapHorizontal" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brand}" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Kept}">
                                <Setter TargetName="Icon" Property="Kind" Value="Lock" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource InkMuted}" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.Edited}">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource BrandTint}" />
                                <Setter TargetName="Icon" Property="Kind" Value="Pencil" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Brand}" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:SettingStatus.NeedsValue}">
                                <Setter TargetName="Side" Property="Background" Value="{StaticResource DiffNeedsValue}" />
                                <Setter TargetName="Icon" Property="Kind" Value="AlertCircle" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Warning}" />
                                <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Value" Property="materialDesign:HintAssist.Hint" Value="{Binding Default}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>

            <Grid Grid.Row="1" Grid.ColumnSpan="3" Visibility="{Binding IsTextMode, Converter={StaticResource InverseBoolToVisibility}}" IsHitTestVisible="False">
                <TextBlock Text="Nothing changes in this file." Style="{StaticResource Caption}" Margin="56,16"
                           Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVisible}}" />
            </Grid>

            <!-- ===== The whole file as text: now on the left, after the change on the right ===== -->
            <TextBox Grid.Row="1" Style="{StaticResource FileText}" Text="{Binding NowText, Mode=OneWay}" IsReadOnly="True"
                     Background="{StaticResource Canvas}" AutomationProperties.Name="The file now"
                     Visibility="{Binding IsTextMode, Converter={StaticResource BoolToVisibility}}" />
            <TextBox x:Name="FileText" Grid.Row="1" Grid.Column="2" Style="{StaticResource FileText}"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     AutomationProperties.Name="The file after the change"
                     Visibility="{Binding IsTextMode, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>

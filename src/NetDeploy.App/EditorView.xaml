<UserControl x:Class="NetDeploy.App.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:app="clr-namespace:NetDeploy.App"
             xmlns:vm="clr-namespace:NetDeploy.App.ViewModels"
             xmlns:editing="clr-namespace:NetDeploy.Core.Editing;assembly=NetDeploy.Core">
    <!-- The deploy.json editor: the steps on the left, the selected one's form on the right, problems below.
         DataContext is an EditorViewModel. -->
    <UserControl.Resources>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True" />
        </Style>
        <Style x:Key="CodeBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="2,4,0,0" />
            <Setter Property="Visibility" Value="{Binding Description, Converter={StaticResource NullToCollapsed}}" />
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
            <Setter Property="Margin" Value="2,4,0,0" />
            <Setter Property="Visibility" Value="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
        </Style>

        <!-- Text, numbers, lines, JSON, yes/no and choices: one template, picked by the field's kind -->
        <DataTemplate DataType="{x:Type vm:ValueFieldViewModel}">
            <StackPanel Margin="0,0,0,16">
                <TextBox x:Name="Box" Style="{StaticResource FieldBox}" materialDesign:HintAssist.Hint="{Binding Label}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox x:Name="Check" Content="{Binding Label}" IsChecked="{Binding IsChecked}" Visibility="Collapsed" Margin="2,2,0,0" />
                <ComboBox x:Name="Choice" Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="{Binding Label}"
                          ItemsSource="{Binding Options}" SelectedItem="{Binding Text}" Visibility="Collapsed" Padding="10,8" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Help}" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static editing:FieldKind.Lines}">
                    <Setter TargetName="Box" Property="Style" Value="{StaticResource CodeBox}" />
                    <Setter TargetName="Box" Property="ToolTip" Value="One per line" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static editing:FieldKind.Json}">
                    <Setter TargetName="Box" Property="Style" Value="{StaticResource CodeBox}" />
                    <Setter TargetName="Box" Property="ToolTip" Value="JSON" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static editing:FieldKind.YesNo}">
                    <Setter TargetName="Box" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static editing:FieldKind.Choice}">
                    <Setter TargetName="Box" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Choice" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A check, a schedule: settings inside a setting -->
        <DataTemplate DataType="{x:Type vm:GroupFieldViewModel}">
            <Border BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="6" Padding="14,12,14,0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Help}" Margin="0,2,0,10" />
                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- When a step runs, or which way an if goes -->
        <DataTemplate DataType="{x:Type vm:ConditionFieldViewModel}">
            <Border BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="6" Padding="14,12,14,12" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="SourceBranch" Width="16" Height="16" Foreground="{StaticResource Brand}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox x:Name="ModePicker" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,10,0,0" Padding="10,8"
                              ItemsSource="{Binding Modes}" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding Mode}" />
                    <TextBox x:Name="AskBox" Style="{StaticResource FieldBox}" Margin="0,10,0,0" Visibility="Collapsed"
                             materialDesign:HintAssist.Hint="The question, such as Run the migration now?" Text="{Binding Ask, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid x:Name="EqualsBoxes" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource FieldBox}" materialDesign:HintAssist.Hint="Value, such as {Environment}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="1" Text="equals" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0" />
                        <TextBox Grid.Column="2" Style="{StaticResource FieldBox}" materialDesign:HintAssist.Hint="Text, such as Production" Text="{Binding EqualsValue, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBox x:Name="ScriptBox" Style="{StaticResource CodeBox}" Margin="0,10,0,0" Visibility="Collapsed"
                             materialDesign:HintAssist.Hint="PowerShell whose last line is True or False" Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox x:Name="JsonBox" Style="{StaticResource CodeBox}" Margin="0,10,0,0" Visibility="Collapsed"
                             materialDesign:HintAssist.Hint="Condition JSON" Text="{Binding AdvancedJson, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Help}" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:ConditionMode.Ask}">
                    <Setter TargetName="AskBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:ConditionMode.ValueEquals}">
                    <Setter TargetName="EqualsBoxes" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:ConditionMode.PowerShell}">
                    <Setter TargetName="ScriptBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:ConditionMode.Advanced}">
                    <Setter TargetName="JsonBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Parameters, or a step's inputs: one row per value -->
        <DataTemplate DataType="{x:Type vm:InputsFieldViewModel}">
            <Border BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="6" Padding="14,12,14,8" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Height="30" Command="{Binding AddCommand}"
                                Content="Add" Tag="{x:Static materialDesign:PackIconKind.Plus}" ContentTemplate="{StaticResource IconLabel}" />
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Help}" Margin="0,2,0,8" />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource FieldBox}" materialDesign:HintAssist.Hint="Name" FontFamily="Cascadia Mono, Consolas"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Steps use it as {Name}" />
                                        <TextBox Grid.Column="2" Style="{StaticResource FieldBox}" materialDesign:HintAssist.Hint="Label"
                                                 Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Grid.Column="4" Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="Type" Padding="10,8"
                                                  ItemsSource="{x:Static vm:InputRowViewModel.Types}" SelectedItem="{Binding Type}" />
                                        <TextBox Grid.Column="6" Style="{StaticResource FieldBox}" materialDesign:HintAssist.Hint="Default"
                                                 Text="{Binding Default, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Grid.Column="7" Content="Optional" IsChecked="{Binding Optional}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <Button Grid.Column="8" Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Padding="0" Foreground="{StaticResource Danger}"
                                                ToolTip="Remove" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                    <TextBox Style="{StaticResource FieldBox}" Margin="0,8,0,0" materialDesign:HintAssist.Hint="Choices, separated by commas"
                                             Text="{Binding Options, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Danger}" FontSize="12" Margin="2,4,0,0"
                                               Visibility="{Binding Problem, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The outline: app settings, then each step, with if branches indented -->
        <materialDesign:Card Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="20,16,12,8">
                    <materialDesign:PopupBox DockPanel.Dock="Right" PlacementMode="BottomAndAlignRightEdges" StaysOpen="False" ToolTip="Add a step after the selected one">
                        <materialDesign:PopupBox.ToggleContent>
                            <Border Background="{StaticResource Brand}" CornerRadius="6" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlaylistPlus" Foreground="White" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="Add step" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </materialDesign:PopupBox.ToggleContent>
                        <ItemsControl ItemsSource="{Binding StepTypes}" Width="340" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="Auto" Padding="14,8" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.AddStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <DockPanel>
                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="{Binding Type, Converter={x:Static app:StepIconConverter.Instance}}"
                                                                     Width="20" Height="20" Foreground="{StaticResource Brand}" Margin="0,2,12,0" VerticalAlignment="Top" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontWeight="Normal" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </materialDesign:PopupBox>
                    <TextBlock Text="Steps" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Move and delete the selected step -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,4,12,10">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Command="{Binding MoveUpCommand}" ToolTip="Move up">
                        <materialDesign:PackIcon Kind="ArrowUp" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Command="{Binding MoveDownCommand}" ToolTip="Move down">
                        <materialDesign:PackIcon Kind="ArrowDown" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="34" Height="34" Command="{Binding DeleteCommand}" ToolTip="Delete the step"
                            Foreground="{StaticResource Danger}">
                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" />
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Padding="8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="{Binding Indent}">
                                <materialDesign:PackIcon DockPanel.Dock="Right" Kind="AlertCircleOutline" Foreground="{StaticResource Warning}" Width="16" Height="16"
                                                         VerticalAlignment="Center" ToolTip="This step has a problem" Background="Transparent"
                                                         Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                <materialDesign:PackIcon x:Name="Icon" DockPanel.Dock="Left" Kind="{Binding Icon}" Foreground="{StaticResource Brand}" Width="18" Height="18"
                                                         VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="Title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:EditorRowKind.Branch}">
                                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource InkMuted}" />
                                    <Setter TargetName="Title" Property="FontSize" Value="12" />
                                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource InkFaint}" />
                                    <Setter TargetName="Icon" Property="Width" Value="15" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:EditorRowKind.Settings}">
                                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </materialDesign:Card>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" MaxHeight="190" />
            </Grid.RowDefinitions>

            <!-- The selected step's form, or the app settings -->
            <materialDesign:Card Style="{StaticResource Panel}" Padding="0">
                <TabControl Style="{StaticResource MaterialDesignFilledTabControl}" materialDesign:ColorZoneAssist.Mode="Standard"
                            materialDesign:ColorZoneAssist.Background="{StaticResource Surface}" materialDesign:ColorZoneAssist.Foreground="{StaticResource Brand}"
                            HorizontalContentAlignment="Left">
                    <TabItem Header="Form">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="24,16,24,8">
                                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="{Binding SelectedIcon}" Width="26" Height="26" Foreground="{StaticResource Brand}"
                                                         VerticalAlignment="Top" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource PanelTitle}" />
                                    <TextBlock Text="{Binding SelectedSchema.Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                               Visibility="{Binding SelectedSchema, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,8,24,16">
                                <Grid>
                                    <!-- App settings and parameters -->
                                    <StackPanel Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource FieldBox}" materialDesign:HintAssist.Hint="App name *" Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Grid.Column="2" Style="{StaticResource FieldBox}" materialDesign:HintAssist.Hint="Version *" Text="{Binding AppVersion, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <CheckBox Content="Needs administrator rights: NetDeploy restarts as administrator before deploying" IsChecked="{Binding RequiresAdmin}" Margin="2,0,0,16" />
                                        <TextBox Style="{StaticResource FieldBox}" materialDesign:HintAssist.Hint="Install folder, usually {InstallDir}"
                                                 Text="{Binding InstallFolder, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,10"
                                                   Text="Steps use {InstanceDir} for the app's folder. Leave it empty if the app isn't installed into one folder." />
                                        <CheckBox Content="Can run as several named instances side by side" IsChecked="{Binding Instances}" IsEnabled="{Binding HasInstall}" Margin="2,0,0,18" />
                                        <ContentControl Content="{Binding Parameters}" Focusable="False" />
                                    </StackPanel>

                                    <!-- The selected step -->
                                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False"
                                                  Visibility="{Binding IsSettingsSelected, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <!-- A branch: its steps are added from the outline -->
                                    <TextBlock FontSize="13" Text="Pick Add step to add a step to this branch.">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected.Kind}" Value="{x:Static vm:EditorRowKind.Branch}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="JSON">
                        <TextBox Text="{Binding Json, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="24,12"
                                 BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </TabItem>
                </TabControl>
            </materialDesign:Card>

            <!-- What NetDeploy would say about this config; click one to go to its step -->
            <materialDesign:Card Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,12,20,6">
                        <materialDesign:PackIcon x:Name="ProblemIcon" Width="18" Height="18" VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="CheckCircle" />
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                            <Setter Property="Kind" Value="AlertOutline" />
                                            <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="{Binding ProblemSummary}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,8"
                                  Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Problems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Height="Auto" Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.SelectProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock TextWrapping="Wrap" FontWeight="Normal"><Run Text="{Binding Where, Mode=OneWay}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" /><Run Text=": " Foreground="{StaticResource Ink}" /><Run Text="{Binding Message, Mode=OneWay}" Foreground="{StaticResource InkMuted}" /></TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:converters="clr-namespace:MaterialDesignThemes.Wpf.Converters;assembly=MaterialDesignThemes.Wpf"
                    xmlns:vm="clr-namespace:NetDeploy.App.ViewModels"
                    xmlns:app="clr-namespace:NetDeploy.App"
                    xmlns:core="clr-namespace:NetDeploy.Core;assembly=NetDeploy.Core">
    <ResourceDictionary.MergedDictionaries>
        <!-- Material Design styles every control; Pantone 301 is the primary colour. -->
        <materialDesign:CustomColorTheme BaseTheme="Light" PrimaryColor="#004B87" SecondaryColor="#004B87" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Palette: Pantone 301 and white, plus tints of 301 and the few status colours the plan needs. -->
    <SolidColorBrush x:Key="Brand" Color="#004B87" />
    <SolidColorBrush x:Key="BrandTint" Color="#E8EFF6" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Canvas" Color="#F4F7FA" />
    <SolidColorBrush x:Key="Hairline" Color="#DCE4EC" />
    <SolidColorBrush x:Key="Ink" Color="#1A2633" />
    <SolidColorBrush x:Key="InkMuted" Color="#5B6B7C" />
    <SolidColorBrush x:Key="InkFaint" Color="#9AA8B6" />
    <SolidColorBrush x:Key="Success" Color="#2E7D32" />
    <SolidColorBrush x:Key="Warning" Color="#9A5B00" />
    <SolidColorBrush x:Key="WarningTint" Color="#FFF4E0" />
    <SolidColorBrush x:Key="Danger" Color="#C62828" />
    <SolidColorBrush x:Key="DangerTint" Color="#FDECEC" />

    <!-- Diff colours, as in Visual Studio and GitHub: red where a line goes, green where one arrives, hatched where a
         side has no line. -->
    <SolidColorBrush x:Key="DiffAdded" Color="#E6FFEC" />
    <SolidColorBrush x:Key="DiffAddedGutter" Color="#CCFFD8" />
    <SolidColorBrush x:Key="DiffRemoved" Color="#FFEBE9" />
    <SolidColorBrush x:Key="DiffRemovedGutter" Color="#FFD7D5" />
    <SolidColorBrush x:Key="DiffNeedsValue" Color="#FFF8C5" />
    <DrawingBrush x:Key="DiffFiller" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F6F8FA" Geometry="M0,0 H8 V8 H0 Z" />
                <GeometryDrawing Geometry="M0,8 L8,0">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#E1E6EB" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- The line between the two sides of a diff -->
    <Style x:Key="DiffDivider" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        <Setter Property="BorderThickness" Value="1,0" />
    </Style>

    <!-- A long list that only builds the rows on screen. Every list of files, settings or log lines uses it, so a
         folder with thousands of files scrolls as smoothly as one with ten. The lists mix row types (folder headings
         and files, sections and settings), so rows are not recycled: a recycled row briefly binds its old template to
         an item of another type, and a command typed for files then throws on a folder heading. -->
    <Style x:Key="VirtualList" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" TrueValue="Collapsed" FalseValue="Visible" />
    <app:CountToVisibilityConverter x:Key="ZeroToVisible" ShowWhenZero="True" />
    <app:CountToVisibilityConverter x:Key="NonZeroToVisible" />
    <converters:NullableToVisibilityConverter x:Key="NullToCollapsed" />
    <converters:NullableToVisibilityConverter x:Key="NullToVisible" NullValue="Visible" NotNullValue="Collapsed" />

    <!-- Thin scroll bars without arrow buttons. -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}" />

    <Style x:Key="AppWindow" TargetType="Window" BasedOn="{StaticResource MaterialDesignWindow}">
        <Setter Property="Background" Value="{StaticResource Canvas}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="TextElement.FontSize" Value="13" />
    </Style>

    <!-- A white panel with a soft shadow. -->
    <Style x:Key="Panel" TargetType="materialDesign:Card">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="UniformCornerRadius" Value="8" />
        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The main action of a window: filled Pantone 301. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
    </Style>

    <!-- A white outlined button for the Pantone 301 header bar. -->
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#99FFFFFF" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
        <Setter Property="materialDesign:RippleAssist.Feedback" Value="White" />
    </Style>

    <!-- An icon followed by a label, for buttons. -->
    <DataTemplate x:Key="IconLabel">
        <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Kind="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                     Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Outlined inputs, tighter than Material's default (16 all round) so forms fit without scrolling. Every text box,
         password box and drop-down in the app uses one of these. -->
    <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="InputPassword" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedRevealPasswordBox}">
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style x:Key="InputChoice" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Input editors, one per InputType. The form below picks one with the field's Type. -->
    <DataTemplate x:Key="TextInput">
        <TextBox Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="{Binding Label}"
                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>
    <DataTemplate x:Key="SecretInput">
        <PasswordBox Style="{StaticResource InputPassword}" materialDesign:HintAssist.Hint="{Binding Label}"
                     materialDesign:PasswordBoxAssist.Password="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>
    <DataTemplate x:Key="YesNoInput">
        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="2,2,0,2" />
    </DataTemplate>
    <DataTemplate x:Key="ChoiceInput">
        <ComboBox Style="{StaticResource InputChoice}" materialDesign:HintAssist.Hint="{Binding Label}"
                  ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
    </DataTemplate>
    <DataTemplate x:Key="PathInput">
        <Grid>
            <TextBox Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="{Binding Label}"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="10,8,40,8" />
            <Button Style="{StaticResource MaterialDesignIconButton}" Command="{Binding BrowseCommand}" ToolTip="Browse"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30" Margin="0,0,4,0">
                <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" />
            </Button>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InputFieldViewModel}">
        <ContentControl Content="{Binding}" Focusable="False" Margin="0,0,0,10">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource TextInput}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="{x:Static core:InputType.Secret}">
                            <Setter Property="ContentTemplate" Value="{StaticResource SecretInput}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="{x:Static core:InputType.YesNo}">
                            <Setter Property="ContentTemplate" Value="{StaticResource YesNoInput}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="{x:Static core:InputType.Choice}">
                            <Setter Property="ContentTemplate" Value="{StaticResource ChoiceInput}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="{x:Static core:InputType.Folder}">
                            <Setter Property="ContentTemplate" Value="{StaticResource PathInput}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="{x:Static core:InputType.File}">
                            <Setter Property="ContentTemplate" Value="{StaticResource PathInput}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DataTemplate>
</ResourceDictionary>

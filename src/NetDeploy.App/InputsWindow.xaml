<Window x:Class="NetDeploy.App.InputsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource AppWindow}" Background="{StaticResource Surface}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel>
        <Border Background="{StaticResource Brand}" Padding="24,18">
            <DockPanel>
                <materialDesign:PackIcon Kind="FormTextbox" Foreground="White" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel>
                    <TextBlock Text="THIS STEP NEEDS A FEW ANSWERS" Foreground="White" Opacity="0.75" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="White" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="24,22,24,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,20">
            <Button Style="{StaticResource QuietButton}" Content="Cancel deploy" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Continue" IsDefault="True" Click="OnContinue" />
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="NetDeploy.App.InputsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
        <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Continue" IsDefault="True" Click="OnContinue" Margin="0,0,8,0" />
            <Button Content="Cancel deploy" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

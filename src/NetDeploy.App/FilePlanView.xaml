<UserControl x:Class="NetDeploy.App.FilePlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:NetDeploy.App.ViewModels"
             xmlns:steps="clr-namespace:NetDeploy.Core.Steps;assembly=NetDeploy.Core">
    <!-- The files of one copy step: how each compares with the server, and what the deploy will do with it.
         DataContext is a FilePlanViewModel. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="AddedRow" Color="#E6FFEC" />
        <SolidColorBrush x:Key="RemovedRow" Color="#FFEBE9" />

        <!-- An action is a small icon button; the chosen one is filled with the action's colour. -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="ToolTip" Value="{Binding Tip}" />
            <Setter Property="Command" Value="{Binding ChooseCommand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding Action}" Value="{x:Static steps:FileAction.Delete}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Danger}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding Action}" Value="{x:Static steps:FileAction.Keep}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource InkMuted}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding Action}" Value="{x:Static steps:FileAction.Replace}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brand}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True" />
                        <Condition Binding="{Binding Action}" Value="{x:Static steps:FileAction.Merge}" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Brand}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:FolderViewModel}">
            <StackPanel Orientation="Horizontal" Height="24" Margin="28,0,0,0">
                <materialDesign:PackIcon Kind="FolderOutline" Width="14" Height="14" Foreground="{StaticResource InkFaint}"
                                         VerticalAlignment="Center" Margin="{Binding Indent}" />
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
            <Border x:Name="Row" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Background="Transparent">
                <Grid Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- How the package's file compares with the server's -->
                    <materialDesign:PackIcon x:Name="State" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Background="Transparent" ToolTip="{Binding StateTip}"
                                             Kind="FileCheckOutline" Foreground="{StaticResource InkFaint}" />

                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Path}" Margin="{Binding Indent}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <!-- What the deploy does with it -->
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Options}" Margin="8,0,4,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ActionButton}">
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="16" Height="16" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static steps:FileState.New}">
                    <Setter TargetName="State" Property="Kind" Value="FilePlusOutline" />
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static steps:FileState.Changed}">
                    <Setter TargetName="State" Property="Kind" Value="FileSyncOutline" />
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Brand}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static steps:FileState.OnlyOnServer}">
                    <Setter TargetName="State" Property="Kind" Value="FileQuestionOutline" />
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource Warning}" />
                </DataTrigger>

                <!-- The row's colour is the outcome: green when a file arrives, red when one goes, blue when it's your call. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding State}" Value="{x:Static steps:FileState.New}" />
                        <Condition Binding="{Binding Action}" Value="{x:Static steps:FileAction.Replace}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AddedRow}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding State}" Value="{x:Static steps:FileState.New}" />
                        <Condition Binding="{Binding Action}" Value="{x:Static steps:FileAction.Merge}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AddedRow}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsChosen}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource BrandTint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action}" Value="{x:Static steps:FileAction.Delete}">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource RemovedRow}" />
                    <Setter TargetName="Name" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Copy step, where it copies to, and the totals -->
        <DockPanel DockPanel.Dock="Top" Margin="4,8,4,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FilePlusOutline" Foreground="{StaticResource Success}" Width="14" Height="14" VerticalAlignment="Center"
                                         ToolTip="Files added" Background="Transparent" />
                <TextBlock Text="{Binding NewCount}" FontSize="12" Margin="3,0,10,0" VerticalAlignment="Center" />
                <materialDesign:PackIcon Kind="FileReplaceOutline" Foreground="{StaticResource Brand}" Width="14" Height="14" VerticalAlignment="Center"
                                         ToolTip="Files replaced or merged" Background="Transparent" />
                <TextBlock Text="{Binding ReplaceCount}" FontSize="12" Margin="3,0,10,0" VerticalAlignment="Center" />
                <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="{StaticResource Danger}" Width="14" Height="14" VerticalAlignment="Center"
                                         ToolTip="Files deleted" Background="Transparent" />
                <TextBlock Text="{Binding DeleteCount}" FontSize="12" Margin="3,0,10,0" VerticalAlignment="Center" />
                <materialDesign:PackIcon Kind="Lock" Foreground="{StaticResource InkMuted}" Width="14" Height="14" VerticalAlignment="Center"
                                         ToolTip="Files left as they are" Background="Transparent" />
                <TextBlock Text="{Binding KeepCount}" FontSize="12" Margin="3,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center"
                                     Margin="0,0,8,0" ToolTip="{Binding Title}" Background="Transparent" />
            <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"><Run Text="{Binding Target, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
        </DockPanel>

        <Grid>
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
            <StackPanel Orientation="Horizontal" Margin="8,4" Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="{StaticResource Success}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="The server already matches the package." Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
